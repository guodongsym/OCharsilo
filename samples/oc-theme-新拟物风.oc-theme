    "designMode": "free",
    "customCss": "[data-design-mode=\"free\"]{--bg:#e0e5ec!important; --surface:#eef0f4!important; --text:#3e4453!important; --accent:#64748b!important; --border:rgba(0,0,0,0.07)!important; --r-lg:26px!important; --r-md:16px!important; color:var(--text)!important; background-color:var(--bg)!important; background-image: linear-gradient(45deg,rgba(255,255,255,.35) 25%,transparent 25%),linear-gradient(-45deg,rgba(255,255,255,.35) 25%,transparent 25%),linear-gradient(45deg,transparent 75%,rgba(255,255,255,.35) 75%),linear-gradient(-45deg,transparent 75%,rgba(255,255,255,.35) 75%) !important; background-size: 28px 28px !important; background-position: 0 0,0 14px,14px -14px,-14px 0 !important; font-family:'Nunito','Inter','Segoe UI',sans-serif!important;}\n[data-design-mode=\"free\"] *{box-sizing:border-box!important;}\n[data-design-mode=\"free\"] ::-webkit-scrollbar{width:9px!important; height:9px!important;}\n[data-design-mode=\"free\"] ::-webkit-scrollbar-track{background:var(--bg)!important; border-radius:12px!important;}\n[data-design-mode=\"free\"] ::-webkit-scrollbar-thumb{background:#c6cedb!important; border-radius:12px!important; box-shadow:inset 2px 2px 4px rgba(0,0,0,.1),inset -2px -2px 4px rgba(255,255,255,.7)!important;}\n[data-design-mode=\"free\"] .art-card,[data-design-mode=\"free\"] .oc-card,[data-design-mode=\"free\"] .wv-card,[data-design-mode=\"free\"] .cal-day-card{background:var(--surface)!important; border:none!important; border-radius:var(--r-lg)!important; box-shadow:9px 9px 18px #b8c0d0,-9px -9px 18px #ffffff!important; padding:14px!important; transition:box-shadow .25s ease,transform .25s ease!important;}\n[data-design-mode=\"free\"] .art-card:hover,[data-design-mode=\"free\"] .oc-card:hover,[data-design-mode=\"free\"] .wv-card:hover,[data-design-mode=\"free\"] .cal-day-card:hover{box-shadow:6px 6px 12px #b8c0d0,-6px -6px 12px #ffffff,inset 1px 1px 2px #ffffff,inset -1px -1px 2px #b8c0d0!important; transform:translateY(-2px)!important;}\n[data-design-mode=\"free\"] .art-card.selected,[data-design-mode=\"free\"] .oc-card.selected,[data-design-mode=\"free\"] .wv-card.selected,[data-design-mode=\"free\"] .cal-day-card.selected{box-shadow:inset 4px 4px 9px #bfc7d6,inset -4px -4px 9px #ffffff!important; background:#e7ebf2!important; border-left:4px solid var(--accent)!important;}\n[data-design-mode=\"free\"] .thumb{width:100%!important; height:auto!important; border-radius:var(--r-md)!important; box-shadow:4px 4px 10px #b8c0d0,-4px -4px 10px #ffffff!important; border:2px solid #f4f7fb!important; object-fit:cover!important; display:block!important;}\n[data-design-mode=\"free\"] .thumb-overlay{background:rgba(255,255,255,.28)!important; border-radius:var(--r-md)!important; backdrop-filter:blur(2px)!important;}\n[data-design-mode=\"free\"] .thumb-title,[data-design-mode=\"free\"] .card-title{color:var(--text)!important; font-weight:800!important; letter-spacing:.3px!important;}\n[data-design-mode=\"free\"] .card-tags{display:flex!important; flex-wrap:wrap!important; gap:6px!important;}\n[data-design-mode=\"free\"] .card-tags span,[data-design-mode=\"free\"] .badge{background:var(--surface)!important; border-radius:999px!important; box-shadow:2px 2px 5px #bfc7d6,-2px -2px 5px #ffffff!important; padding:4px 12px!important; color:#5a6270!important; font-size:.74rem!important; font-weight:600!important;}\n[data-design-mode=\"free\"] .star-ic{color:#f0b63e!important; text-shadow:1px 1px 2px rgba(180,145,60,.5)!important;}\n[data-design-mode=\"free\"] .thumb-price{color:var(--accent)!important; font-weight:800!important;}\n[data-design-mode=\"free\"] .thumb-unpaid{color:#d25f5f!important; font-weight:600!important;}\n[data-design-mode=\"free\"] .btn{background:var(--surface)!important; border:none!important; border-radius:var(--r-md)!important; box-shadow:4px 4px 10px #b8c0d0,-4px -4px 10px #ffffff!important; color:var(--text)!important; font-weight:700!important; padding:10px 18px!important; transition:box-shadow .2s ease,transform .18s ease!important; cursor:pointer!important;}\n[data-design-mode=\"free\"] .btn:hover{box-shadow:2px 2px 5px #b8c0d0,-2px -2px 5px #ffffff!important; transform:scale(.97)!important;}\n[data-design-mode=\"free\"] .btn:active,[data-design-mode=\"free\"] .btn.primary:active{box-shadow:inset 4px 4px 8px #b8c0d0,inset -4px -4px 8px #ffffff!important; transform:scale(.98)!important;}\n[data-design-mode=\"free\"] .btn.primary{background:#e8ecf3!important; color:var(--accent)!important; box-shadow:4px 4px 10px #b8c0d0,-4px -4px 10px #ffffff,inset 1px 1px 1px #ffffff!important;}\n[data-design-mode=\"free\"] .modal,[data-design-mode=\"free\"] .edit-panel{background:var(--surface)!important; border-radius:calc(var(--r-lg) + 4px)!important; box-shadow:14px 14px 30px #b8c0d0,-14px -14px 30px #ffffff!important; border:none!important;}\n[data-design-mode=\"free\"] .modal .btn,[data-design-mode=\"free\"] .edit-panel .btn{margin:4px!important;}\n[data-design-mode=\"free\"] .sidebar{background:rgba(238,240,244,.88)!important; backdrop-filter:blur(10px)!important; box-shadow:8px 0 16px rgba(163,177,198,.45),-1px 0 2px #ffffff!important; border-right:none!important;}\n[data-design-mode=\"free\"] .side-head{background:transparent!important; box-shadow:none!important;}\n[data-design-mode=\"free\"] .sidebar a,[data-design-mode=\"free\"] .sidebar .menu-item{display:block!important; padding:10px 14px!important; margin:6px 10px!important; border-radius:var(--r-md)!important; box-shadow:3px 3px 6px #b8c0d0,-3px -3px 6px #ffffff!important; color:var(--text)!important; text-decoration:none!important; font-weight:600!important; transition:box-shadow .2s ease!important;}\n[data-design-mode=\"free\"] .sidebar a:hover,[data-design-mode=\"free\"] .sidebar .menu-item:hover{box-shadow:inset 2px 2px 5px #b8c0d0,inset -2px -2px 5px #ffffff!important;}\n[data-design-mode=\"free\"] .topbar{position:relative!important; box-shadow:0 4px 14px rgba(163,177,198,.45)!important; border-bottom:1px solid rgba(255,255,255,.6)!important;}\n[data-design-mode=\"free\"] .topbar::before{content:\"\"!important; position:absolute!important; inset:0!important; background:rgba(238,240,244,.8)!important; backdrop-filter:blur(12px)!important; -webkit-backdrop-filter:blur(12px)!important; z-index:-1!important; pointer-events:none!important;}\n[data-design-mode=\"free\"] .total-price-bar{background:var(--surface)!important; border-radius:var(--r-lg)!important; box-shadow:6px 6px 14px #b8c0d0,-6px -6px 14px #ffffff!important; border:1px solid rgba(255,255,255,.7)!important; padding:16px 20px!important;}\n[data-design-mode=\"free\"] .filter-trigger,[data-design-mode=\"free\"] .view-toolbar{background:var(--surface)!important; border-radius:var(--r-md)!important; box-shadow:3px 3px 8px #b8c0d0,-3px -3px 8px #ffffff!important; border:none!important;}\n[data-design-mode=\"free\"] input,[data-design-mode=\"free\"] select,[data-design-mode=\"free\"] textarea{background:#eef0f4!important; border:none!important; border-radius:var(--r-md)!important; box-shadow:inset 3px 3px 7px #c0c8d8,inset -3px -3px 7px #ffffff!important; color:var(--text)!important; padding:10px 14px!important; font-family:inherit!important; font-size:.92rem!important;}\n[data-design-mode=\"free\"] input:focus,[data-design-mode=\"free\"] select:focus,[data-design-mode=\"free\"] textarea:focus{box-shadow:inset 3px 3px 7px #c0c8d8,inset -3px -3px 7px #ffffff,0 0 0 3px rgba(100,116,139,.22)!important; outline:none!important;}\n[data-design-mode=\"free\"] input[type=checkbox]{appearance:none!important; -webkit-appearance:none!important; width:20px!important; height:20px!important; background:var(--surface)!important; border-radius:7px!important; box-shadow:3px 3px 6px #b8c0d0,-3px -3px 6px #ffffff!important; cursor:pointer!important; vertical-align:middle!important; position:relative!important;}\n[data-design-mode=\"free\"] input[type=checkbox]:checked{box-shadow:inset 3px 3px 6px #b8c0d0,inset -3px -3px 6px #ffffff!important; background:#e8ecf3!important;}\n[data-design-mode=\"free\"] input[type=checkbox]:checked::after{content: '✓' !important; position:absolute!important; top:-2px!important; left:3px!important; font-size:15px!important; font-weight:800!important; color:var(--accent)!important;}\n[data-design-mode=\"free\"] input[type=radio]{accent-color:var(--accent)!important;}\n[data-design-mode=\"free\"] .gallery-grid{display:grid!important; gap:24px!important; padding:28px!important;}\n[data-design-mode=\"free\"] .content-header{background:transparent!important; padding:20px 28px 0!important;}\n[data-design-mode=\"free\"] .cal-day-card{min-height:120px!important;}\n[data-design-mode=\"free\"] .oc-card .avatar,[data-design-mode=\"free\"] .wv-card .cover{border-radius:var(--r-md)!important; box-shadow:4px 4px 10px #b8c0d0,-4px -4px 10px #ffffff!important;}\n[data-design-mode=\"free\"] .neu-card{display: flex !important; flex-direction: column !important; height: 100% !important;}\n[data-design-mode=\"free\"] .neu-sel{position: absolute !important; top: 12px !important; left: 12px !important; z-index: 5 !important;}\n[data-design-mode=\"free\"] .neu-thumb{position: relative !important; margin-bottom: 12px !important;}\n[data-design-mode=\"free\"] .neu-thumb .thumb{width:100%!important; height:160px!important; object-fit:cover!important; border-radius:18px!important;}\n[data-design-mode=\"free\"] .neu-type-pill{position: absolute !important; top: 10px !important; right: 10px !important; background: rgba(238,240,244,.92) !important; padding: 5px 12px !important; border-radius: 999px !important; font-size: .68rem !important; font-weight: 700 !important; color: #4a5568 !important; box-shadow: 2px 2px 5px rgba(0,0,0,.08),-2px -2px 5px rgba(255,255,255,.9) !important; backdrop-filter: blur(4px) !important;}\n[data-design-mode=\"free\"] .neu-body{flex: 1 !important; display: flex !important; flex-direction: column !important; gap: 8px !important;}\n[data-design-mode=\"free\"] .neu-title{margin: 0 !important; font-size: 1rem !important; font-weight: 800 !important; color: #343b49 !important; line-height: 1.3 !important;}\n[data-design-mode=\"free\"] .neu-meta{display: flex !important; flex-wrap: wrap !important; gap: 8px !important; align-items: center !important; color: #7a8396 !important; font-size: .76rem !important; font-weight: 600 !important;}\n[data-design-mode=\"free\"] .neu-tags{display: flex !important; flex-wrap: wrap !important; gap: 5px !important; margin-top: 2px !important;}\n[data-design-mode=\"free\"] .neu-foot{display: flex !important; justify-content: space-between !important; align-items: center !important; margin-top: auto !important; padding-top: 8px !important;}\n[data-design-mode=\"free\"] .neu-prices{display: flex !important; flex-direction: column !important; gap: 2px !important;}\n[data-design-mode=\"free\"] .neu-price{color: #64748b !important; font-weight: 800 !important; font-size: .95rem !important;}\n[data-design-mode=\"free\"] .neu-unpaid{color: #d25f5f !important; font-size: .72rem !important; font-weight: 600 !important;}\n[data-design-mode=\"free\"] .neu-actions .btn{padding:6px 12px!important; font-size:.78rem!important; border-radius:12px!important;}\n[data-design-mode=\"free\"] .badge{display:inline-block!important;}\n[data-design-mode=\"free\"] .sidebar .badge{box-shadow:2px 2px 4px #b8c0d0,-2px -2px 4px #ffffff!important;}\n[data-design-mode=\"free\"] .section-title{color:var(--text)!important; text-shadow:1px 1px 0 rgba(255,255,255,.6)!important;}\n[data-design-mode=\"free\"] .footer-actions{background:var(--surface)!important; border-radius:var(--r-lg)!important; box-shadow:4px 4px 10px #b8c0d0,-4px -4px 10px #ffffff!important;}\n\n/* ===== [新拟物风·瀑布流/时间轴/日历 布局修复] =====\n   覆盖主题自身 [data-design-mode=\"free\"] .gallery-grid{display:grid!important; minmax(240px,1fr);}\n   该规则把瀑布流锁成等高网格，并把时间轴/日历内容挤在 240px 列里导致右侧留白 */\n[data-ai-theme] .gallery-grid.view-masonry,\n[data-design-mode=\"free\"] .gallery-grid.view-masonry{display:block!important; column-gap:16px!important;}\n[data-ai-theme] .gallery-grid.view-masonry .art-card,\n[data-design-mode=\"free\"] .gallery-grid.view-masonry .art-card{display:inline-block!important; width:100%!important; margin-bottom:16px!important; break-inside:avoid!important; aspect-ratio:auto!important; height:auto!important;}\n[data-ai-theme] .gallery-grid.view-masonry .thumb,\n[data-ai-theme] .gallery-grid.view-masonry .art-card img,\n[data-design-mode=\"free\"] .gallery-grid.view-masonry .thumb,\n[data-design-mode=\"free\"] .gallery-grid.view-masonry .art-card img{width:100%!important; height:auto!important; aspect-ratio:auto!important; display:block!important;}\n[data-ai-theme] #galleryGrid.view-timeline,\n[data-design-mode=\"free\"] #galleryGrid.view-timeline{display:block!important; width:100%!important;}\n[data-ai-theme] #galleryGrid.view-calendar,\n[data-design-mode=\"free\"] #galleryGrid.view-calendar{display:block!important; width:100%!important;}\n\n/* ===== [新拟物风·精简模式 只显示图片] =====\n   精简模式（body.compact-mode）下隐藏卡片全部文字信息，只保留图片 */\n[data-ai-theme] body.compact-mode .neu-body,\n[data-design-mode=\"free\"] body.compact-mode .neu-body,\n[data-ai-theme] body.compact-mode .neu-type-pill,\n[data-design-mode=\"free\"] body.compact-mode .neu-type-pill{display:none!important;}\n[data-ai-theme] body.compact-mode .neu-card,\n[data-design-mode=\"free\"] body.compact-mode .neu-card{min-height:0!important;}\n/* ===== [新拟物风·精简模式 卡片贴齐图片] =====\n   精简模式下移除卡片内边距与封面下间距，让图片直接顶到卡片边，卡片与图片之间不留空 */\n[data-ai-theme] body.compact-mode .art-card,\n[data-design-mode=\"free\"] body.compact-mode .art-card{padding:0!important;}\n[data-ai-theme] body.compact-mode .neu-card,\n[data-design-mode=\"free\"] body.compact-mode .neu-card{height:auto!important; display:block!important;}\n[data-ai-theme] body.compact-mode .neu-thumb,\n[data-design-mode=\"free\"] body.compact-mode .neu-thumb{margin-bottom:0!important; border-radius:var(--r-lg)!important;}\n[data-ai-theme] body.compact-mode .gallery-grid:not(.view-masonry) .neu-thumb .thumb,\n[data-design-mode=\"free\"] body.compact-mode .gallery-grid:not(.view-masonry) .neu-thumb .thumb{width:100%!important; height:auto!important; aspect-ratio:1/1!important; object-fit:cover!important; display:block!important; border-radius:var(--r-lg)!important;}\n[data-ai-theme] body.compact-mode .gallery-grid.view-masonry .neu-thumb .thumb,\n[data-design-mode=\"free\"] body.compact-mode .gallery-grid.view-masonry .neu-thumb .thumb{width:100%!important; height:auto!important; aspect-ratio:auto!important; object-fit:cover!important; display:block!important; border-radius:var(--r-lg)!important;}\n\n\n/* ===== [新拟物风·卡片局部美化·冷色] =====\n   仅标签/金额/按钮三处做新拟物质感；配色沿用主题原生冷灰蓝\n   (--bg#e0e5ec / --surface#eef0f4 / 阴影#b8c0d0·#ffffff)，不动卡片本体与其他元素 */\n/* 标签：内凹药丸（按下质感） */\n[data-ai-theme] .neu-tags,\n[data-design-mode=\"free\"] .neu-tags{background:#eef0f4!important; color:#64748b!important; font-weight:700!important; font-size:.76rem!important; padding:7px 14px!important; border-radius:999px!important; box-shadow:inset 4px 4px 8px #b8c0d0, inset -4px -4px 8px #ffffff!important;}\n/* 金额：价格加粗大字号、突出；未付用软红小药丸 */\n[data-ai-theme] .neu-price,\n[data-design-mode=\"free\"] .neu-price{color:#3e4453!important; font-weight:800!important; font-size:1.12rem!important;}\n[data-ai-theme] .neu-unpaid,\n[data-design-mode=\"free\"] .neu-unpaid{background:#f7e0db!important; color:#cf6b5a!important; font-size:.72rem!important; font-weight:700!important; padding:2px 10px!important; border-radius:999px!important;}\n/* 按钮：凸起质感，hover 转为内凹（按下感） */\n[data-ai-theme] .neu-actions .btn,\n[data-design-mode=\"free\"] .neu-actions .btn{background:#eef0f4!important; color:#64748b!important; border:none!important; border-radius:12px!important; box-shadow:4px 4px 8px #b8c0d0, -4px -4px 8px #ffffff!important; transition:box-shadow .2s ease, color .2s ease!important;}\n[data-ai-theme] .neu-actions .btn:hover,\n[data-design-mode=\"free\"] .neu-actions .btn:hover{box-shadow:inset 4px 4px 8px #b8c0d0, inset -4px -4px 8px #ffffff!important; color:#3e4453!important;}",
    "customHtml": "<template data-slot=\"card\">\n  <div class=\"neu-card\">\n    <div class=\"neu-sel\">{{selBox}}</div>\n    <div class=\"neu-thumb\">{{cover}}<span class=\"neu-type-pill\">{{type}}</span></div>\n    <div class=\"neu-body\">\n      <h3 class=\"neu-title\">{{title}}</h3>\n      <div class=\"neu-meta\"><span>{{author}}</span><span>·</span><span>{{duration}}</span></div>\n      <div class=\"neu-tags\">{{tags}}</div>\n      <div class=\"neu-foot\">\n        <div class=\"neu-prices\"><span class=\"neu-price\">{{price}}</span><span class=\"neu-unpaid\">{{unpaid}}</span></div>\n        <div class=\"neu-actions\">{{coverEditBtn}}</div>\n      </div>\n    </div>\n  </div>\n</template>",
    "spacing": {
      "base": 8,
      "scale": 1
    },
    "font": {
      "family": "system"
    },
    "layoutMap": {},
    "iconMode": "line",
    "iconFontUrl": "",
    "customIcons": {}
  },
  "exportedAt": "2026-08-11T03:24:34.784Z"
}