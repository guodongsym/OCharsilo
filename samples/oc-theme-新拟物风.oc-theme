    },
    "layout": {
      "fontScale": 100,
      "zoom": 100,
      "hoverAnim": true,
      "sidebarW": 280,
      "btnStyle": "solid",
      "scrollbar": true,
      "motion": true,
      "lightbox": "rgba(0,0,0,0.6)",
