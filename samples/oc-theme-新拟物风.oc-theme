      "on-accent": "#ffffff",
      "success": "#498361",
      "success-soft": "#e6ede9",
      "warning": "#ab852b",
      "warning-soft": "#f1ede1",
      "danger": "#c94936",
      "danger-soft": "#f1e4e2",
      "info": "#457292",
      "info-soft": "#e4eaee",
      "cp": "#2a7d68",
      "cp-soft": "#e8f1ef",
      "cp-border": "#bfe0d6",
      "cp-fg": "#ffffff",
      "scrim": "#000000",
      "cal-heat-1": "#ebecef",
      "cal-heat-2": "#d5d7dd",
      "cal-heat-3": "#b7bbc5",
      "cal-heat-4": "#9096a7",
      "cal-heat-5": "#656d83",
      "cal-heat-1-fg": "#1a1410",
      "cal-heat-2-fg": "#1a1410",
      "cal-heat-3-fg": "#1a1410",
      "cal-heat-4-fg": "#1a1410",
      "cal-heat-5-fg": "#ffffff"
    },
    "radius": {
      "lg": 16,
      "md": 12,
      "sm": 8,
      "xs": 6,
      "pill": 999,
      "square": false
