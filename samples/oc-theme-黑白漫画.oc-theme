lute !important; top: -12px !important; left: -12px !important; width: 24px !important; height: 24px !important; background: #1a1a1a !important; color: #ff0 !important; border-radius: 50% !important; display: flex !important; align-items: center !important; justify-content: center !important; font-weight: 900 !important; font-size: 14px !important; z-index: 10 !important; border: 2px solid #ff0 !important; font-family: 'Courier New' !important;}\n[data-design-mode='free'] .edit-panel{background:#faf6e9!important; border:4px solid #1a1a1a!important; border-radius:0!important; box-shadow:10px 10px 0 rgba(0,0,0,.3)!important;}\n[data-design-mode='free'] .edit-panel > div{border-bottom:2px dotted #1a1a1a!important; padding:8px 0!important;}\n[data-design-mode='free'] .edit-panel input[type='checkbox']{outline:1px solid #1a1a1a!important;}\n[data-design-mode='free'] .edit-panel input[type='checkbox']:checked{outline:3px solid #1a1a1a!important;}\n[data-design-mode='free'] .edit-panel input[type='range']{accent-color:#1a1a1a!important; border:2px solid #1a1a1a!important; height:8px!important; border-radius:0!important;}\n[data-design-mode='free'] .edit-panel input[type='color']{border:2px solid #1a1a1a!important; border-radius:0!important; padding:0!important;}\n[data-design-mode='free'] ::-webkit-scrollbar{width: 14px !important; height: 14px !important; background: #f0f0e0 !important;}\n[data-design-mode='free'] ::-webkit-scrollbar-track{border: 2px solid #1a1a1a !important; background: repeating-linear-gradient(45deg,#f0f0e0 0 4px,#e0d8c0 4px 8px) !important;}\n[data-design-mode='free'] ::-webkit-scrollbar-thumb{background: #1a1a1a !important; border: 2px solid #f0f0e0 !important; border-radius: 8px !important; box-shadow: inset 0 0 0 1px #fff !important;}\n[data-design-mode='free'] ::-webkit-scrollbar-thumb:hover{background: #333 !important;}\n[data-design-mode='free'] ::-webkit-scrollbar-corner{background: #1a1a1a !important;}\n[data-design-mode='free'] .empty-state,[data-design-mode='free'] .placeholder{background:repeating-linear-gradient(45deg,#ff0 0 10px,transparent 10px 20px)!important; border:3px dashed #1a1a1a!important; color:#1a1a1a!important; font-weight:900!important; padding:30px!important; text-align:center!important;}\n[data-design-mode='free'] .toast,[data-design-mode='free'] .notification{border:3px solid #1a1a1a!important; border-radius:0!important; background:#fff!important; box-shadow:4px 4px 0 #1a1a1a!important; font-family:'Comic Sans MS',cursive!important; font-weight:700!important;}\n[data-design-mode='free'] .toast::before,[data-design-mode='free'] .notification::before{content: '!! ' !important; color:#f00!important;}\n[data-design-mode='free'] .toast.success::before{content: '✓ ' !important; color:#080!important;}\n[data-design-mode='free'] .toast.error::before{content: '✗ ' !important; color:#f00!important;}\n[data-design-mode='free'] .badge::before{content: '[' !important; color:#ff0!important;}\n[data-design-mode='free'] .badge::after{content: ']' !important; color:#ff0!important;}\n[data-design-mode='free'] .art-card .sel-box,[data-design-mode='free'] .art-card label{align-self:start!important; z-index:5!important;}\n[data-design-mode='free'] .art-card .sel-box:empty{display:block!important; position: absolute !important; top: 4px !important; left: 4px !important; width: 20px !important; height: 20px !important; border:2px solid #1a1a1a!important; background:#fff!important;}\n[data-design-mode='free'] .art-card .sel-box input[type='checkbox']{opacity:0!important; position: absolute !important; z-index: 6 !important; width: 24px !important; height: 24px !important;}\n[data-design-mode='free'] .art-card .sel-box:empty::after{content: '✕' !important; position: absolute !important; top: -2px !important; left: 2px !important; font-size: 16px !important; color: #1a1a1a !important;}\n[data-design-mode='free'] .art-card .sel-box:has(input:checked){background:#1a1a1a!important;}\n[data-design-mode='free'] .art-card .sel-box:has(input:checked)::after{content: '✓' !important; color: #ff0 !important; top: -4px !important; left: 2px !important;}\n[data-design-mode='free'] .card-tags .tag{background:none!important; border:1px solid #1a1a1a!important; border-radius:0!important; font-size:10px!important; padding:0 4px!important; box-shadow:none!important;}\n[data-design-mode='free'] .card-tags .tag::before{content: '#' !important; color:#f00!important;}\n[data-design-mode='free'] .card-tags .tag:not(:last-child)::after{content: ',' !important; color:#1a1a1a!important; font-weight: 900 !important;}\n[data-design-mode='free'] .total-price-bar .price-detail{font-size:14px!important; background:transparent!important; border:0!important;}\n[data-design-mode='free'] .total-price-bar .price-detail::before{content:'『'!important;}\n[data-design-mode='free'] .total-price-bar .price-detail::after{content:'』'!important;}\n[data-design-mode='free'] .total-price-bar .total-amount{font-size:20px!important; color:#ff0!important; text-shadow:2px 2px 0 #000!important;}",
    "customHtml": "<template data-slot=\"card\"><div class=\"manga-card\">{{selBox}}<div class=\"manga-cover\">{{cover}}<div class=\"manga-cover-title\">{{title}}</div></div><div class=\"manga-info\"><div class=\"manga-title-row\"><h3 class=\"manga-title\">{{title}}</h3><span class=\"manga-type\">{{type}}</span></div><div class=\"manga-meta\">{{author}} · {{duration}} · {{software}}</div><div class=\"manga-price-row\">{{price}}{{unpaid}}</div><div class=\"manga-tags\">{{tags}}</div><div class=\"manga-actions\">{{coverEditBtn}}<button class=\"manga-bookmark\">★</button></div></div></div></template><template data-slot=\"sidebar\"><div class=\"manga-side-accent\"><span>◤</span><br>OC<br>MANGA<br><span>◥</span></div></template><template data-slot=\"modal\"><div class=\"manga-modal-sticker\">◤☆◥<br>COMIC<br>◣☆◢</div></template>",
