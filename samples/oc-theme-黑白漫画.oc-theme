px 0 #d9d4c0!important; font-family:'Comic Sans MS',cursive!important;}\n[data-design-mode='free'] .gallery-grid{background-image:linear-gradient(rgba(0,0,0,.03) 1px,transparent 1px),linear-gradient(90deg,rgba(0,0,0,.03) 1px,transparent 1px)!important; background-size:24px 24px!important; padding:12px!important;}\n[data-design-mode='free'] .content-header{background:repeating-linear-gradient(-45deg,#1a1a1a 0 10px,transparent 10px 20px)!important; color:#fff!important; border-bottom:4px solid #1a1a1a!important; font-weight:900!important; letter-spacing:3px!important; text-transform:uppercase!important; padding:14px!important; text-shadow:2px 2px 0 #000!important;}\n[data-design-mode='free'] .btn{background:#fff!important; color:#1a1a1a!important; border:3px solid #1a1a1a!important; border-radius:0!important; box-shadow:3px 3px 0 #1a1a1a!important; font-family:'Comic Sans MS',cursive!important; font-weight:900!important; text-transform:uppercase!important; letter-spacing:1px!important; padding:6px 14px!important; transition:all .1s ease!important; position:relative!important; top:0!important; left:0!important;}\n[data-design-mode='free'] .btn:hover{transform:translate(-2px,-2px)!important; box-shadow:5px 5px 0 #1a1a1a!important; background:#ff0!important;}\n[data-design-mode='free'] .btn:active{transform:translate(2px,2px)!important; box-shadow:1px 1px 0 #1a1a1a!important; background:#f0f!important;}\n[data-design-mode='free'] .btn.primary{background:#1a1a1a!important; color:#fff!important; border-color:#1a1a1a!important; box-shadow:3px 3px 0 #666!important;}\n[data-design-mode='free'] .btn.primary:hover{background:#333!important; color:#ff0!important; box-shadow:5px 5px 0 #666!important;}\n[data-design-mode='free'] .btn.primary:active{background:#000!important; color:#fff!important;}\n[data-design-mode='free'] .modal{background:#faf6e9!important; border:4px solid #1a1a1a!important; border-radius:0!important; box-shadow:12px 12px 0 rgba(0,0,0,.5)!important; font-famil