e'] .view-toolbar{background:repeating-linear-gradient(90deg,#fff 0 16px,#f0f0e0 16px 32px)!important; border-bottom:3px solid #1a1a1a!important; padding:8px!important;}\n[data-design-mode='free'] ::selection{background:#1a1a1a!important; color:#ff0!important;}\n[data-design-mode='free'] input:checked+*,[data-design-mode='free'] input[type='checkbox']:checked{accent-color:#1a1a1a!important; outline:2px solid #1a1a1a!important;}\n[data-design-mode='free'] input[type='checkbox']{border:2px solid #1a1a1a!important; border-radius:0!important; background:#fff!important; width:16px!important; height:16px!important; appearance:none!important; -webkit-appearance:none!important; cursor:pointer!important; position:relative!important; outline:2px solid transparent!important;}\n[data-design-mode='free'] input[type='checkbox']::after{content: '✕' !important; position: absolute !important; top: -4px !important; left: 1px !important; font-size: 16px !important; font-weight: 900 !important; color: #1a1a1a !important; line-height: 1 !important; display: none !important;}\n[data-design-mode='free'] input[type='checkbox']:checked{background:#1a1a1a!important;}\n[data-design-mode='free'] input[type='checkbox']:checked::after{display: block !important; color:#ff0!important; top: -4px !important; left: 1px !important; transform: rotate(45deg) !important;}\n[data-design-mode='free'] input[type='checkbox']:hover{outline:2px solid #ff0!important;}\n[data-design-mode='free'] select,[data-design-mode='free'] input[type='text'],[data-design-mode='free'] input[type='number'],[data-design-mode='free'] textarea{background:#fff!important; border:2px solid #1a1a1a!important; border-radius:0!important; font-family:'Courier New',monospace!important; color:#1a1a1a!important; font-weight:700!important;}\n[data-design-mode='free'] select:focus,[data-design-mode='free'] input:focus,[data-design-mode='free'] textarea:focus{outline:3px solid #ff0!important; outline-offset:0!important; border-color:#1a1a1a!