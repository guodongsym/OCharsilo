    "customCss": "body[data-design-mode='free']{background:#f5f2e9!important; font-family:'Comic Sans MS','Chalkboard SE','Hiragino Maru Gothic Pro',sans-serif!important;}\n[data-design-mode='free'] .art-card,[data-design-mode='free'] .oc-card,[data-design-mode='free'] .wv-card,[data-design-mode='free'] .cal-day-card{background:#fff!important; border:3px solid #1a1a1a!important; border-radius:0!important; box-shadow:6px 6px 0 #1a1a1a!important; transition:all .12s ease!important; position: relative !important; overflow:visible!important;}\n[data-design-mode='free'] .art-card::before,[data-design-mode='free'] .oc-card::before,[data-design-mode='free'] .wv-card::before,[data-design-mode='free'] .cal-day-card::before{content: '' !important; position: absolute !important; top: -3px !important; left: -3px !important; right: -3px !important; bottom: -3px !important; border: 1px solid #1a1a1a !important; pointer-events: none !important; z-index: 0 !important;}\n[data-design-mode='free'] .art-card:hover,[data-design-mode='free'] .oc-card:hover,[data-design-mode='free'] .wv-card:hover,[data-design-mode='free'] .cal-day-card:hover{transform:translate(-3px,-3px)!important; box-shadow:9px 9px 0 #1a1a1a!important;}\n[data-design-mode='free'] .art-card:active,[data-design-mode='free'] .oc-card:active{transform:translate(2px,2px)!important; box-shadow:2px 2px 0 #1a1a1a!important;}\n[data-design-mode='free'] .thumb{border:2px solid #1a1a1a!important; border-radius:0!important; filter:grayscale(100%) contrast(1.3) brightness(.95)!important;}\n[data-design-mode='free'] .thumb-overlay{background:repeating-linear-gradient(45deg,rgba(0,0,0,.08) 0 6px,transparent 6px 12px)!important; border-bottom:2px solid #1a1a1a!important;}\n[data-design-mode='free'] .thumb-title{font-family:'Comic Sans MS','Chalkboard SE',cursive!important; font-weight:900!important; text-transform:uppercase!important; letter-spacing:.5px!important; color:#1a1a1a!important; background:linear-gradient(0deg,#ff0 0%,#ff