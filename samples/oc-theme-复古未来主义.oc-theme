{
  "ocUiTheme": 1,
  "schema": 3,
  "name": "复古未来主义",
  "base": "light",
  "builtin": true,
  "config": {
    "colors": {
      "bg": "#f6f2f1",
      "surface": "#fefefd",
      "surface-hover": "#f2eceb",
      "surface-2": "#f2eceb",
      "surface-3": "#e8dedc",
      "border": "#e1d5d3",
      "border-strong": "#ceb8b3",
      "text": "#261c1a",
      "text-secondary": "#745d58",
      "text-2": "#745d58",
      "text-3": "#98837e",
      "accent": "#c24a2e",
      "accent-dark": "#a03a22",
      "accent-strong": "#a03a22",
      "accent-light": "#f2e0dc",
      "accent-soft": "#f2e0dc",
      "accent-soft-2": "#ebcfc9",
      "on-accent": "#ffffff",
      "success": "#498361",
      "success-soft": "#e6ede9",
      "warning": "#ab852b",
      "warning-soft": "#f1ede1",
      "danger": "#c94936",
      "danger-soft": "#f1e4e2",
      "info": "#457292",
      "info-soft": "#e4eaee",
      "cp": "#2a7d68",
      "cp-soft": "#e8f1ef",
      "cp-border": "#bfe0d6",
      "cp-fg": "#ffffff",
      "scrim": "#000000",
      "cal-heat-1": "#f2eae8",
      "cal-heat-2": "#e6d0cb",
      "cal-heat-3": "#daada2",
      "cal-heat-4": "#ce7c69",
      "cal-heat-5": "#b64b32",
      "cal-heat-1-fg": "#1a1410",
      "cal-heat-2-fg": "#1a1410",
      "cal-heat-3-fg": "#1a1410",
      "cal-heat-4-fg": "#1a1410",
      "cal-heat-5-fg": "#ffffff"
    },
    "radius": {
      "lg": 16,
      "md": 12,
      "sm": 8,
      "xs": 6,
      "pill": 999,
      "square": false
    },
    "texture": {
      "shadow": "md",
      "shadowOn": true,
      "glass": false,
      "glassBlur": 12,
      "borderW": 1
    },
    "layout": {
      "fontScale": 100,
      "zoom": 100,
      "hoverAnim": true,
      "sidebarW": 280,
      "btnStyle": "solid",
      "scrollbar": true,
      "motion": true,
      "lightbox": "rgba(0,0,0,0.6)",
      "mobileGlass": false,
      "mobileMotion": false,
      "scrollbarColor": "#808080"
    },
    "artStyle": "default",
    "layoutRules": {
      "cardStyle": "overlay",
      "sidebarPos": "left",
      "showTopbar": true,
      "showSidebar": true,
      "showTotalBar": true,
      "showFilterBar": true,
      "lowPerf": false
    },
    "designMode": "free",
    "customCss": "/* ===== 复古未来主义 · 浅色 ===== */\n/* 全局基底 */\nbody[data-design-mode=\"free\"]{--bg:#f2efe6 !important; --surface:#fffbf0 !important; --text:#2b2a24 !important; --accent:#c44b2e !important; --border:#b8a98c !important; --r-lg:24px !important; --r-md:12px !important; --shadow:6px 6px 0 rgba(78,58,38,.18) !important; background-color:var(--bg) !important; background-image:repeating-linear-gradient(45deg,rgba(196,75,46,.05) 0 2px,transparent 2px 12px),radial-gradient(circle at 18% 22%,rgba(196,75,46,.12),transparent 40%),radial-gradient(circle at 82% 76%,rgba(120,92,48,.14),transparent 45%) !important; color:var(--text) !important; font-family:'Courier New',Courier,'IBM Plex Mono','Space Mono',monospace !important; letter-spacing:.02em !important;}\n\n/* 复古网格纹理 */\n[data-ai-theme] *,\n[data-design-mode=\"free\"] *{scrollbar-color:#c44b2e var(--surface) !important;}\n[data-design-mode=\"free\"] ::selection{background:#c44b2e !important; color:#fff !important;}\n\n/* ===== 卡片重构 ===== */\n[data-design-mode=\"free\"] .art-card,\n[data-ai-theme] .art-card{background:var(--surface) !important; border:2px solid #2b2a24 !important; border-radius:var(--r-lg) !important; box-shadow:8px 8px 0 #d0c3a8, 8px 8px 0 2px #2b2a24 !important; position:relative !important; transition:transform .15s ease,box-shadow .15s ease,filter .15s ease !important; overflow:visible !important;}\n[data-design-mode=\"free\"] .art-card:hover{transform:translate(-2px,-2px) !important; box-shadow:12px 12px 0 #c44b2e,12px 12px 0 2px #2b2a24 !important; filter:saturate(1.1) !important;}\n[data-design-mode=\"free\"] .art-card::before{content:\"\" !important; position:absolute !important; top:-8px !important; left:14px !important; width:56px !important; height:16px !important; background:#f2efe6 !important; border:2px solid #2b2a24 !important; border-radius:50%/100% 100% 40% 40% !important; z-index:2 !important; box-shadow:inset 0 4px 0 #c44b2e !important;}\n\n/* 封面 */\n[data-design-mode=\"free\"] .thumb{border-radius:calc(var(--r-lg) - 6px) !important; border:2px solid #2b2a24 !important; filter:sepia(.18) saturate(1.15) contrast(1.02) !important; background-blend-mode:overlay !important;}\n[data-design-mode=\"free\"] .thumb-overlay{background:linear-gradient(180deg,transparent 40%,rgba(43,42,36,.72) 100%) !important;}\n[data-design-mode=\"free\"] .thumb-title{font-weight:700 !important; font-size:1.02rem !important; letter-spacing:.03em !important; text-transform:uppercase !important; color:#fff !important; text-shadow:2px 2px 0 #2b2a24 !important;}\n\n/* 卡片徽章（类型/价格） */\n[data-design-mode=\"free\"] .badge,\n[data-design-mode=\"free\"] .thumb-price,\n[data-design-mode=\"free\"] .thumb-unpaid{font-family:'Courier New',monospace !important; border:2px solid #2b2a24 !important; border-radius:4px !important; background:#ffd29d !important; color:#2b2a24 !important; font-weight:700 !important; text-transform:uppercase !important; letter-spacing:.06em !important; box-shadow:2px 2px 0 #2b2a24 !important; padding:2px 8px !important;}\n[data-design-mode=\"free\"] .thumb-unpaid{background:#ff8a70 !important; color:#2b2a24 !important;}\n\n/* 星标 */\n[data-design-mode=\"free\"] .star-ic{color:transparent !important; -webkit-text-stroke: 1px #c44b2e !important; fill:transparent !important; display:inline-block !important; transform:skew(-8deg) scale(.92) !important; filter: drop-shadow(1px 1px 0 #2b2a24) !important;}\n\n/* 标签 */\n[data-design-mode=\"free\"] .card-tags{display:flex !important; flex-wrap:wrap !important; gap:6px !important; margin-top:6px !important;}\n[data-design-mode=\"free\"] .card-tags span{background:transparent !important; border:1px dashed #c44b2e !important; color:#98341c !important; border-radius:0 !important; font-size:11px !important; padding:1px 6px !important; font-family:'Courier New',monospace !important; font-weight:700 !important;}\n\n/* 选择框 */\n[data-design-mode=\"free\"] input[type=\"checkbox\"]{appearance:none !important; width:18px !important; height:18px !important; border:2px solid #2b2a24 !important; border-radius:4px !important; background:#fff !important; box-shadow:2px 2px 0 #c44b2e !important; cursor:pointer !important; transition:all .15s !important; position:relative !important;}\n[data-design-mode=\"free\"] input[type=\"checkbox\"]:checked{background:#c44b2e !important; border-color:#2b2a24 !important; box-shadow:2px 2px 0 #2b2a24 !important;}\n[data-design-mode=\"free\"] input[type=\"checkbox\"]:checked::after{content:\"\\2713\" !important; position:absolute !important; top:-2px !important; left:1px !important; color:#fff !important; font-size:15px !important; font-weight:900 !important;}\n\n/* ===== 布局 ===== */\n[data-design-mode=\"free\"] .gallery-grid{gap:28px 24px !important; padding:24px !important;}\n[data-design-mode=\"free\"] .sidebar{background:var(--surface) !important; border-right:3px double #2b2a24 !important; border-radius:0 !important; padding:20px 16px !important; box-shadow:inset -6px 0 0 rgba(196,75,46,.12) !important;}\n[data-design-mode=\"free\"] .side-head{font-family:'Courier New',monospace !important; text-transform:uppercase !important; letter-spacing:.12em !important; border-bottom:2px solid #c44b2e !important; padding-bottom:8px !important; margin-bottom:14px !important; color:#2b2a24 !important; position:relative !important;}\n[data-design-mode=\"free\"] .side-head::after{content:\"//\" !important; color:#c44b2e !important; position:absolute !important; right:0 !important; top:0 !important; font-weight:900 !important;}\n[data-design-mode=\"free\"] .topbar{background:var(--surface) !important; border-bottom:3px double #2b2a24 !important; box-shadow:0 4px 0 rgba(196,75,46,.2) !important; backface-visibility: hidden !important;}\n[data-design-mode=\"free\"] .content-header{border-bottom:2px dashed #b8a98c !important; margin-bottom:12px !important;}\n\n/* ===== 按钮 ===== */\n[data-design-mode=\"free\"] .btn{background:var(--surface) !important; border:2px solid #2b2a24 !important; border-radius:6px !important; color:#2b2a24 !important; font-family:'Courier New',monospace !important; font-weight:700 !important; text-transform:uppercase !important; letter-spacing:.07em !important; padding:6px 14px !important; cursor:pointer !important; box-shadow:3px 3px 0 #2b2a24 !important; transition:all .12s ease !important; position:relative !important; background-image:linear-gradient(180deg,rgba(196,75,46,.08),transparent 40%) !important;}\n[data-design-mode=\"free\"] .btn:hover{background:#ffe3b1 !important; transform:translate(-1px,-1px) !important; box-shadow:5px 5px 0 #c44b2e !important;}\n[data-design-mode=\"free\"] .btn:active{transform:translate(2px,2px) !important; box-shadow:1px 1px 0 #2b2a24 !important;}\n[data-design-mode=\"free\"] .btn.primary{background:#c44b2e !important; color:#fff !important; border-color:#2b2a24 !important; box-shadow:3px 3px 0 #2b2a24 !important; text-shadow:1px 1px 0 #2b2a24 !important;}\n[data-design-mode=\"free\"] .btn.primary:hover{background:#a83b21 !important; box-shadow:5px 5px 0 #2b2a24 !important;}\n\n/* ===== 弹窗 ===== */\n[data-design-mode=\"free\"] .modal{background:var(--surface) !important; border:3px solid #2b2a24 !important; border-radius:18px !important; box-shadow:10px 10px 0 #c44b2e,10px 10px 0 3px #2b2a24 !important; padding:24px !important; background-image:radial-gradient(circle at 90% 10%,rgba(196,75,46,.12),transparent 35%),repeating-linear-gradient(45deg,rgba(196,75,46,.03) 0 2px,transparent 2px 10px) !important;}\n[data-design-mode=\"free\"] .edit-panel{background:var(--surface) !important; border:2px solid #2b2a24 !important; border-radius:14px !important; box-shadow:6px 6px 0 rgba(196,75,46,.5) !important;}\n\n/* ===== 总计条 ===== */\n[data-design-mode=\"free\"] .total-price-bar{background:#ffe3b1 !important; border:2px solid #2b2a24 !important; border-radius:10px !important; box-shadow:4px 4px 0 #c44b2e !important; font-family:'Courier New',monospace !important; font-weight:700 !important; text-transform:uppercase !important; padding:10px 18px !important; position:fixed !important; top:64px !important; right:14px !important; z-index:70 !important;}\n[data-design-mode=\"free\"] .total-price-bar::before{content:\"$\" !important; position:absolute !important; left:6px !important; top:50% !important; transform:translateY(-50%) !important; font-size:1.4em !important; color:#c44b2e !important;}\n\n/* ===== 选中态 ===== */\n[data-design-mode=\"free\"] .art-card.selected,\n[data-design-mode=\"free\"] .oc-card.selected,\n[data-design-mode=\"free\"] .wv-card.selected{outline:3px solid #c44b2e !important; outline-offset:2px !important; background:#fff6e0 !important; box-shadow:0 0 0 4px rgba(196,75,46,.25), 8px 8px 0 #c44b2e !important;}\n\n/* ===== 悬停 ===== */\n[data-design-mode=\"free\"] .art-card:hover .thumb,\n[data-design-mode=\"free\"] .oc-card:hover .thumb,\n[data-design-mode=\"free\"] .wv-card:hover .thumb{transform:scale(1.02) !important; filter:sepia(0) saturate(1.3) !important; transition:all .2s !important;}\n\n/* ===== 侧栏筛选等 ===== */\n[data-design-mode=\"free\"] .filter-trigger,\n[data-design-mode=\"free\"] .view-toolbar{border-bottom:2px dashed #b8a98c !important; background:transparent !important;}\n\n/* ===== 表单 ===== */\n[data-design-mode=\"free\"] input[type=\"text\"],\n[data-design-mode=\"free\"] input[type=\"search\"],\n[data-design-mode=\"free\"] select,\n[data-design-mode=\"free\"] textarea{background:#fffdf5 !important; border:2px solid #2b2a24 !important; border-radius:4px !important; color:#2b2a24 !important; font-family:'Courier New',monospace !important; box-shadow:inset 3px 3px 0 rgba(196,75,46,.1) !important; padding:6px 8px !important;}\n[data-design-mode=\"free\"] input:focus,\n[data-design-mode=\"free\"] select:focus,\n[data-design-mode=\"free\"] textarea:focus{outline:none !important; border-color:#c44b2e !important; box-shadow:inset 3px 3px 0 rgba(196,75,46,.2), 2px 2px 0 #c44b2e !important;}\n\n/* ===== 日历卡 / OC / 世界观 ===== */\n[data-design-mode=\"free\"] .cal-day-card{background:var(--surface) !important; border:2px solid #2b2a24 !important; border-radius:10px !important; box-shadow:4px 4px 0 #c44b2e !important; font-family:'Courier New',monospace !important;}\n[data-design-mode=\"free\"] .oc-card,\n[data-design-mode=\"free\"] .wv-card{background:var(--surface) !important; border:2px solid #2b2a24 !important; border-radius:15px !important; box-shadow:6px 6px 0 rgba(196,75,46,.3) !important; transition:all .15s !important;}\n[data-design-mode=\"free\"] .oc-card:hover,\n[data-design-mode=\"free\"] .wv-card:hover{transform:translate(-2px,-2px) !important; box-shadow:8px 8px 0 #c44b2e !important;}\n\n/* ===== 全局链接 / 滚动 ===== */\n[data-design-mode=\"free\"] a{color:#a83b21 !important; text-decoration:underline wavy #c44b2e 1px !important; text-underline-offset:3px !important;}\n[data-design-mode=\"free\"] ::-webkit-scrollbar{width:14px !important; height:14px !important;}\n[data-design-mode=\"free\"] ::-webkit-scrollbar-track{background:var(--bg) !important; border-left:2px solid #2b2a24 !important;}\n[data-design-mode=\"free\"] ::-webkit-scrollbar-thumb{background:repeating-linear-gradient(45deg,#c44b2e 0 4px,#a83b21 4px 8px) !important; border:2px solid #2b2a24 !important; border-radius:4px !important;}\n\n/* ===== 复古扫描线动画 ===== */\n@keyframes ai-theme-scanline{0%{background-position: 0 0 !important; }\n  100%{background-position: 0 28px !important; };}\n[data-design-mode=\"free\"] .gallery-grid{position:relative !important;}\n[data-design-mode=\"free\"] .gallery-grid::after{content:\"\" !important; pointer-events:none !important; position:fixed !important; inset:0 !important; z-index:9999 !important; background:repeating-linear-gradient(0deg,rgba(196,75,46,.02) 0 2px,transparent 2px 4px) !important; animation:ai-theme-scanline 8s linear infinite !important; mix-blend-mode:multiply !important;}\n\n/* ===== 卡面太阳快捷键角标 ===== */\n[data-design-mode=\"free\"] .art-card::after{content:\"\\2605\" !important; position:absolute !important; top:-12px !important; right:12px !important; font-size:18px !important; color:#c44b2e !important; background:var(--surface) !important; border:2px solid #2b2a24 !important; border-radius:50% !important; width:24px !important; height:24px !important; display:flex !important; align-items:center !important; justify-content:center !important; z-index:3 !important; box-shadow:2px 2px 0 #2b2a24 !important; line-height:1 !important;}\n\n/* 原生控件隐藏时规避 */\n[data-design-mode=\"free\"] .art-card :where(img,div,span){transition:all .18s ease !important;}\n\n/* ===== [复古未来主义·灰度/模糊修复] ===== */\n/* 主题 .thumb 的 sepia filter(!important) 会盖掉 app 的灰度/模糊（app 无 !important）。\n   用更高优先级(!important) 把 grayscale(1)/blur(9px) 重新落到 .thumb（含 hover 保底，使其持续生效）。 */\n[data-ai-theme] .thumb.grayscaled,\n[data-design-mode=\"free\"] .thumb.grayscaled{filter:grayscale(1)!important;}\n[data-ai-theme] .thumb.grayscaled img,\n[data-design-mode=\"free\"] .thumb.grayscaled img{filter:grayscale(1)!important;}\n[data-ai-theme] .art-card:hover .thumb.grayscaled,\n[data-design-mode=\"free\"] .art-card:hover .thumb.grayscaled{filter:grayscale(1)!important;}\n[data-ai-theme] .thumb.blurred,\n[data-design-mode=\"free\"] .thumb.blurred{filter:blur(9px)!important;}\n[data-ai-theme] .art-card:hover .thumb.blurred,\n[data-design-mode=\"free\"] .art-card:hover .thumb.blurred{filter:blur(9px)!important;}\n\n/* ===== [复古未来主义·精简模式只显图] ===== */\n/* 精简模式：只显示图片，隐藏全部文字信息与装饰徽章、顶部选择框、原右上角编辑按钮。 */\n[data-ai-theme] body.compact-mode .vt-sel-wrap,\n[data-design-mode=\"free\"] body.compact-mode .vt-sel-wrap{position:absolute!important; top:8px!important; left:8px!important; display:flex!important;}\n[data-ai-theme] body.compact-mode .vt-sel-wrap .sel-check,\n[data-design-mode=\"free\"] body.compact-mode .vt-sel-wrap .sel-check{position:static!important; top:auto!important; left:auto!important;}\n[data-ai-theme] body.compact-mode .art-card:hover .vt-count-badge,\n[data-design-mode=\"free\"] body.compact-mode .art-card:hover .vt-count-badge{display:flex!important;}\n[data-ai-theme] body.compact-mode .vt-title-row,\n[data-design-mode=\"free\"] body.compact-mode .vt-title-row{display:none!important;}\n[data-ai-theme] body.compact-mode .vt-meta-row,\n[data-design-mode=\"free\"] body.compact-mode .vt-meta-row{display:none!important;}\n[data-ai-theme] body.compact-mode .vt-tags-row,\n[data-design-mode=\"free\"] body.compact-mode .vt-tags-row{display:none!important;}\n[data-ai-theme] body.compact-mode .vt-footer-row,\n[data-design-mode=\"free\"] body.compact-mode .vt-footer-row{display:none!important;}\n[data-ai-theme] body.compact-mode .vt-badge-row,\n[data-design-mode=\"free\"] body.compact-mode .vt-badge-row{display:none!important;}\n/* 封面铺满整张卡片（去掉倾斜/缩放与边框，图片按原比例裁切填满） */\n[data-ai-theme] body.compact-mode .vt-card-shell,\n[data-design-mode=\"free\"] body.compact-mode .vt-card-shell{padding:0!important; gap:0!important; background:transparent!important;}\n[data-ai-theme] body.compact-mode .vt-cover-wrap,\n[data-design-mode=\"free\"] body.compact-mode .vt-cover-wrap{position:absolute!important; inset:0!important; height:100%!important; width:100%!important; border:none!important; border-radius:0!important; box-shadow:none!important; background:transparent!important; overflow:hidden!important;}\n[data-ai-theme] body.compact-mode .vt-cover-inner,\n[data-design-mode=\"free\"] body.compact-mode .vt-cover-inner{height:100%!important; transform:none!important;}\n[data-ai-theme] body.compact-mode .vt-cover-inner .thumb,\n[data-design-mode=\"free\"] body.compact-mode .vt-cover-inner .thumb{width:100%!important; height:100%!important; border:none!important; border-radius:0!important; object-fit:cover!important; display:block!important;}\n[data-ai-theme] body.compact-mode .vt-cover-inner .thumb img,\n[data-design-mode=\"free\"] body.compact-mode .vt-cover-inner .thumb img{width:100%!important; height:100%!important; object-fit:cover!important; display:block!important;}\n/* 去掉卡片边框/阴影/装饰（tab 与星标），只留干净图片 */\n[data-ai-theme] body.compact-mode .gallery-grid:not(.view-masonry) .art-card,\n[data-design-mode=\"free\"] body.compact-mode .gallery-grid:not(.view-masonry) .art-card{border:none!important; background:transparent!important; box-shadow:none!important;}\n[data-ai-theme] body.compact-mode .art-card::before,\n[data-design-mode=\"free\"] body.compact-mode .art-card::before{display:none!important;}\n[data-ai-theme] body.compact-mode .art-card::after,\n[data-design-mode=\"free\"] body.compact-mode .art-card::after{display:none!important;}\n\n/* ===== [复古未来主义·卡片右下角悬浮编辑按钮] ===== */\n/* 卡片（整体）右下角悬浮「编辑」按钮，悬停整张卡片才出现（所有视图通用）。\n   复用 app 的 .cover-edit-btn（[v52] 已改为 querySelectorAll 全量绑定），点击直接进入编辑表单。 */\n[data-ai-theme] .vt-edit-btn,\n[data-design-mode=\"free\"] .vt-edit-btn{position:absolute!important; right:8px!important; bottom:8px!important; z-index:6!important; width:30px!important; height:30px!important; border-radius:50%!important; border:2px solid #2b2a24!important; background:#c44b2e!important; color:#fff!important; font-size:15px!important; line-height:26px!important; text-align:center!important; cursor:pointer!important; padding:0!important; opacity:0!important; transform:translateY(4px) scale(.92)!important; transition:opacity .15s ease, transform .15s ease!important; box-shadow:2px 2px 0 #2b2a24!important;}\n[data-ai-theme] .vt-card-shell:hover .vt-edit-btn,\n[data-design-mode=\"free\"] .vt-card-shell:hover .vt-edit-btn{opacity:1!important; transform:translateY(0) scale(1)!important;}\n[data-ai-theme] .vt-edit-btn:hover,\n[data-design-mode=\"free\"] .vt-edit-btn:hover{background:#a83b21!important; color:#fff!important;}\n/* ===== [复古未来主义·瀑布流+精简模式 图片按原比例] ===== */\n/* 瀑布流+精简模式下，卡片高度应由图片自身比例撑开，不能做 absolute 填充满容器，\n   否则 .art-card 为 inline-block 且子元素全脱离文档流时会塌陷成一条线。 */\n[data-ai-theme] body.compact-mode .gallery-grid.view-masonry .art-card,\n[data-design-mode=\"free\"] body.compact-mode .gallery-grid.view-masonry .art-card{display:inline-block!important; width:100%!important; height:auto!important; background:transparent!important; border:none!important; box-shadow:none!important; aspect-ratio:auto!important; break-inside:avoid!important;}\n[data-ai-theme] body.compact-mode .gallery-grid.view-masonry .art-card::before,\n[data-design-mode=\"free\"] body.compact-mode .gallery-grid.view-masonry .art-card::before,\n[data-ai-theme] body.compact-mode .gallery-grid.view-masonry .art-card::after,\n[data-design-mode=\"free\"] body.compact-mode .gallery-grid.view-masonry .art-card::after{display:none!important;}\n\n/* 卡片外壳由图片撑开 */\n[data-ai-theme] body.compact-mode .gallery-grid.view-masonry .vt-card-shell,\n[data-design-mode=\"free\"] body.compact-mode .gallery-grid.view-masonry .vt-card-shell{height:auto!important; padding:0!important; gap:0!important; background:transparent!important; display:block!important;}\n\n/* 封面恢复文档流，高度由图片决定 */\n[data-ai-theme] body.compact-mode .gallery-grid.view-masonry .vt-cover-wrap,\n[data-design-mode=\"free\"] body.compact-mode .gallery-grid.view-masonry .vt-cover-wrap{position:relative!important; inset:auto!important; height:auto!important; width:100%!important; border:none!important; border-radius:0!important; box-shadow:none!important; background:transparent!important; overflow:hidden!important;}\n[data-ai-theme] body.compact-mode .gallery-grid.view-masonry .vt-cover-inner,\n[data-design-mode=\"free\"] body.compact-mode .gallery-grid.view-masonry .vt-cover-inner{height:auto!important; transform:none!important;}\n\n/* 图片按原比例显示，宽度100%，高度自适应 */\n[data-ai-theme] body.compact-mode .gallery-grid.view-masonry .vt-cover-inner .thumb,\n[data-design-mode=\"free\"] body.compact-mode .gallery-grid.view-masonry .vt-cover-inner .thumb,\n[data-ai-theme] body.compact-mode .gallery-grid.view-masonry .vt-cover-inner .thumb img,\n[data-design-mode=\"free\"] body.compact-mode .gallery-grid.view-masonry .vt-cover-inner .thumb img{width:100%!important; height:auto!important; aspect-ratio:auto!important; object-fit:cover!important; display:block!important; border:none!important; border-radius:0!important;}\n\n/* 编辑按钮仍固定在卡片右下角 */\n[data-ai-theme] body.compact-mode .gallery-grid.view-masonry .vt-edit-btn,\n[data-design-mode=\"free\"] body.compact-mode .gallery-grid.view-masonry .vt-edit-btn{right:8px!important; bottom:8px!important;}",
    "customHtml": "<template data-slot=\"card\">\n<div class=\"vt-card-shell\" style=\"position:relative;padding:14px;display:flex;flex-direction:column;gap:8px;height:100%;box-sizing:border-box;\">\n  <div class=\"vt-sel-wrap\" style=\"position:absolute;top:-14px;left:12px;z-index:5;display:flex;gap:6px;\">{{selBox}}</div>\n  <div class=\"vt-cover-wrap\" style=\"position:relative;border:2px solid #2b2a24;border-radius:14px;overflow:hidden;background:#e9dfc8;box-shadow:inset 0 0 0 2px #fffdf5;\">\n    <div class=\"vt-count-badge\" style=\"display:none;gap:6px;position:absolute;top:8px;right:8px;z-index:6;background:rgba(43,42,36,.78);color:#ffe3b1;font-family:\"Courier New\",monospace;font-size:11px;font-weight:700;padding:3px 8px;border-radius:4px;border:1px solid #fff;\"><span>{{imgCountLabel}}</span><span>{{fileCountLabel}}</span></div><div class=\"vt-cover-inner\" style=\"position:relative;padding:0;margin:0;line-height:0;transform:rotate(-1.2deg) scale(1.04);\">{{cover}}</div>\n    <div class=\"vt-badge-row\" style=\"position:absolute;left:8px;bottom:8px;right:8px;display:flex;justify-content:space-between;align-items:flex-end;pointer-events:none;\"><span style=\"background:#2b2a24;color:#ffe3b1;font-family:'Courier New',monospace;font-size:11px;font-weight:700;padding:2px 8px;border-radius:4px;border:1px solid #fff;\">{{type}}</span><span style=\"background:#c44b2e;color:#fff;font-family:'Courier New',monospace;font-size:12px;font-weight:700;padding:2px 8px;border-radius:4px;border:1px solid #2b2a24;\">{{price}}</span></div>\n  </div>\n  <div class=\"vt-title-row\" style=\"display:flex;align-items:baseline;justify-content:space-between;gap:6px;\">\n    <h3 style=\"margin:0;font-family:'Courier New',monospace;font-size:15px;font-weight:700;color:#2b2a24;text-transform:uppercase;letter-spacing:.04em;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1;\">{{title}}</h3>\n    <span style=\"flex-shrink:0;display:flex;gap:2px;align-items:center;\"><span style=\"color:#c44b2e;font-size:13px;line-height:1;\">★</span><span style=\"font-size:12px;font-weight:700;color:#2b2a24;\">{{rating}}</span></span>\n  </div>\n  <div class=\"vt-meta-row\" style=\"display:flex;justify-content:space-between;font-size:11px;color:#6b5e47;font-family:'Courier New',monospace;\"><span>{{author}}</span><span>{{imgN}}p</span></div>\n  <div class=\"vt-tags-row\" style=\"font-size:0;display:flex;gap:4px;flex-wrap:wrap;margin-top:2px;\">{{tags}}</div>\n  <div class=\"vt-footer-row\" style=\"margin-top:auto;padding-top:6px;border-top:1px dashed #c44b2e;display:flex;justify-content:flex-end;align-items:center;\"><span style=\"font-family:'Courier New',monospace;font-size:10px;color:#6b5e47;\">{{rights}} · {{duration}}</span></div>\n  <button type=\"button\" class=\"vt-edit-btn cover-edit-btn\" data-id=\"{{id}}\" title=\"编辑\">✎</button>\n</div>\n</template>",
    "spacing": {
      "base": 8,
      "scale": 1
    },
    "font": {
      "family": "system"
    },
    "layoutMap": {},
    "iconMode": "emoji",
