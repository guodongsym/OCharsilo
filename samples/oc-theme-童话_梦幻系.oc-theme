      "warning-soft": "#f8ecd2",
      "danger": "#cf6b5a",
      "danger-soft": "#f7e0db",
      "info": "#5b87a8",
      "info-soft": "#e1ecf3",
      "cp": "#2a7d68",
      "cp-soft": "#e8f1ef",
      "cp-border": "#bfe0d6",
      "cp-fg": "#ffffff",
      "scrim": "#000000",
      "cal-heat-1": "#f5e6ee",
      "cal-heat-2": "#edc4da",
      "cal-heat-3": "#e894c1",
      "cal-heat-4": "#e751a0",
      "cal-heat-5": "#d6127a",
      "cal-heat-1-fg": "#1a1410",
      "cal-heat-2-fg": "#1a1410",
      "cal-heat-3-fg": "#1a1410",
      "cal-heat-4-fg": "#1a1410",
      "cal-heat-5-fg": "#ffffff"
    },
    "radius": {
      "lg": 16,
      "md": 12,
      "sm": 8,
      "xs": 6,
      "pill": 999,
      "square": false
    },
