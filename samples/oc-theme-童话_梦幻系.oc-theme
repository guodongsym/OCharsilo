      "text": "#2c251c",
      "text-secondary": "#6c6051",
      "text-2": "#6c6051",
      "text-3": "#9a8c77",
      "accent": "#fe3ea4",
      "accent-dark": "#b06a33",
      "accent-strong": "#b06a33",
      "accent-light": "#f7e9da",
      "accent-soft": "#f7e9da",
      "accent-soft-2": "#f1dcc6",
      "on-accent": "#ffffff",
      "success": "#5f9a6b",
      "success-soft": "#e3f0e6",
