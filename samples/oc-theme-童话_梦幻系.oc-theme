{
  "ocUiTheme": 1,
  "schema": 3,
  "name": "童话/梦幻系",
  "base": "light",
  "builtin": true,
  "config": {
    "colors": {
      "bg": "#f7f3ec",
      "surface": "#ffffff",
      "surface-hover": "#f3ede3",
      "surface-2": "#f3ede3",
      "surface-3": "#ebe2d4",
      "border": "#e7ddcb",
