    "designMode": "free",
    "customCss": "/* ===== 哥特大教堂全套主题（Gothic Cathedral） =====\n * 覆盖：配色 / 字体 / 背景石墙纹理 / 拱形卡片布局 / 纹章图标 / 金线装饰 / 尖拱封面\n * 用法：主题编辑器 → 自由设计 → 把本文件粘到「CSS 片段」，\n *       再把随附的卡片模板粘到「HTML 片段」，两者一起应用 = 全套哥特风。\n * 已带 !important，直接生效（sanitizeCss 仅用渐变，无外部 url(blocked)，安全）。\n */\n\n/* —— 0. 配色变量 —— */\n:root{--g-bg: #08070a !important; --g-stone: #0f0c14 !important; --g-stone2: #16121d !important; --g-gold: #c9a227 !important; --g-gold-hi: #e8c252 !important; --g-blood: #7a0e0e !important; --g-blood-hi: #b22222 !important; --g-ink: #e8dcc0 !important; --g-muted: #9a8c70 !important; --g-line: #3a2c14 !important;}\n\n/* —— 1. 全局：石墙背景 + 烛光 + 衬线大字 —— */\nhtml, body{background:\n    radial-gradient(circle at 15% -10%, rgba(122,14,14,.28), transparent 45%),\n    radial-gradient(circle at 85% 110%, rgba(40,20,60,.32), transparent 50%),\n    repeating-linear-gradient(0deg, transparent 0 38px, rgba(0,0,0,.45) 38px 40px),\n    repeating-linear-gradient(90deg, transparent 0 38px, rgba(0,0,0,.32) 38px 40px),\n    var(--g-bg) !important; color:var(--g-ink) !important; font-family:'Cinzel','UnifrakturMaguntia','Songti SC','STSong','SimSun','Times New Roman',serif !important; letter-spacing:.3px !important;}\n.gallery-grid, .main, #main, .content{background:transparent !important;}\n.empty{color:var(--g-muted) !important; text-align: center !important;}\n\n/* —— 2. 顶栏：黑铁 + 金描边 —— */\n.topbar{background:linear-gradient(180deg, rgba(20,15,26,.97), rgba(8,6,10,.97)) !important; border-bottom:1px solid var(--g-gold) !important; box-shadow:0 2px 22px rgba(0,0,0,.8) !important; color:var(--g-ink) !important;}\n\n/* —— 3. 侧栏：暗紫石 + 纹章图标 + 选中态 —— */\n.sidebar{background:linear-gradient(180deg, #160f20, #0b0810) !important; border-right:1px solid var(--g-gold) !important; color:var(--g-ink) !important; width:248px !important;}\n.side-title{color:var(--g-gold-hi) !important; font-size:1.15rem !important; letter-spacing:2px !important; text-align:center !important; padding-bottom:6px !important; border-bottom:1px solid var(--g-line) !important;}\n.side-title::after{content: '' !important; display: block !important; height: 2px !important; margin-top: 8px !important; background: linear-gradient(90deg, transparent, var(--g-gold), transparent) !important;}\n.side-head{color:var(--g-muted) !important; letter-spacing:2px !important; font-size:.78rem !important; border-bottom:1px solid var(--g-line) !important; text-transform:uppercase !important;}\n.side-sep{border-top:1px dashed var(--g-line) !important; margin:8px 0 !important;}\n\n/* 系统导航项 */\n.sidebar .nav-item{color:var(--g-ink) !important; letter-spacing:1px !important;}\n.sidebar .nav-item::before{content: '⚜ ' !important; color: var(--g-gold) !important;}\n.sidebar .nav-item:hover, .sidebar .nav-item.active{background:rgba(201,162,39,.14) !important; color:var(--g-gold-hi) !important; border-left:3px solid var(--g-gold) !important;}\n\n/* 画廊项 + 选中态 + 悬停 */\n.sidebar .gallery-item{position: relative !important; color:var(--g-ink) !important; border-left:3px solid transparent !important; border-radius:0 6px 6px 0 !important; letter-spacing:.5px !important; transition:background .22s, border-color .22s, box-shadow .22s, color .22s !important;}\n.sidebar .gallery-item::before{content: '⚜ ' !important; color: var(--g-gold) !important; opacity: .5 !important; transition: opacity .22s !important;}\n.sidebar .gallery-item:hover{background:rgba(201,162,39,.10) !important; border-left-color:var(--g-gold) !important; box-shadow:inset 0 0 18px rgba(201,162,39,.10) !important;}\n.sidebar .gallery-item.active{background:linear-gradient(90deg, rgba(122,14,14,.34), rgba(201,162,39,.14)) !important; border-left:3px solid var(--g-gold-hi) !important; color:var(--g-gold-hi) !important; font-weight:600 !important; box-shadow:inset 0 0 22px rgba(201,162,39,.20), 0 0 16px rgba(122,14,14,.45) !important;}\n.sidebar .gallery-item.active::before{content: '✦ ' !important; color: var(--g-gold-hi) !important; opacity: 1 !important;}\n.sidebar .gallery-item .count{background:rgba(201,162,39,.18) !important; color:var(--g-gold-hi) !important; border:1px solid var(--g-line) !important; border-radius:10px !important; font-size:.72rem !important; padding:0 7px !important;}\n.sidebar .gallery-item.active .count{background:var(--g-gold) !important; color:#1a0606 !important; border-color:var(--g-gold-hi) !important;}\n.sidebar .rename-gallery-btn{color:var(--g-muted) !important; opacity: .6 !important;}\n.sidebar .rename-gallery-btn:hover{color:var(--g-gold-hi) !important; opacity: 1 !important;}\n\n/* —— 4. 画廊网格：加宽列 + 大间距，凸显拱卡 —— */\n.gallery-grid{grid-template-columns:repeat(auto-fill, minmax(232px,1fr)) !important; gap:26px !important; padding:24px !important;}\n\n/* —— 5. 哥特拱形卡片（配合 HTML 模板的 .goth-card） —— */\n.art-card{background:transparent !important; border:none !important; box-shadow:none !important; padding:0 !important;}\n.goth-card{position: relative !important; background: linear-gradient(160deg, #140f1c, #0a0710) !important; border: 1px solid var(--g-line) !important; border-radius: 16px 16px 6px 6px !important; box-shadow: 0 0 0 1px #000, 0 12px 32px rgba(0,0,0,.75) !important; overflow: hidden !important; color: var(--g-ink) !important; transition: box-shadow .25s, transform .25s !important;}\n.goth-card::before{/* 拱顶金线 */\n  content: '' !important; position: absolute !important; top: 0 !important; left: 14% !important; right: 14% !important; height: 3px !important; background: linear-gradient(90deg, transparent, var(--g-gold), transparent) !important; z-index: 3 !important;}\n.goth-arch{position: relative !important; aspect-ratio: 3/4 !important; overflow: hidden !important; background: #0a0710 !important; border-bottom: 1px solid var(--g-line) !important; clip-path: polygon(0 8%, 12% 0, 88% 0, 100% 8%, 100% 100%, 0 100%) !important;}\n.goth-arch .thumb, .goth-arch img{width: 100% !important; height: 100% !important; object-fit: cover !important; display: block !important; filter: sepia(.28) contrast(1.06) brightness(.9) saturate(.85) !important;}\n.goth-plate{padding: 12px 14px 16px !important; text-align: center !important;}\n.goth-title{font-size: 1.06rem !important; color: var(--g-gold-hi) !important; letter-spacing: 1px !important; text-shadow: 0 1px 0 #000 !important; display: -webkit-box !important; -webkit-line-clamp: 2 !important; -webkit-box-orient: vertical !important; overflow: hidden !important;}\n.goth-sub{color: var(--g-muted) !important; font-size: .82rem !important; margin-top: 5px !important;}\n.goth-row{display: flex !important; justify-content: space-between !important; align-items: center !important; margin-top: 9px !important; font-size: .85rem !important;}\n.goth-row .type{color: var(--g-gold) !important;}\n.goth-price{color: #d98b8b !important; font-weight: 600 !important;}\n.goth-tags{margin-top: 9px !important; display: flex !important; flex-wrap: wrap !important; gap: 5px !important; justify-content: center !important;}\n.goth-tags .badge, .goth-tags .card-tag{background:rgba(201,162,39,.12) !important; border:1px solid var(--g-line) !important; color:var(--g-gold) !important; border-radius:3px !important;}\n.goth-card:hover{box-shadow: 0 0 0 1px var(--g-gold), 0 0 34px rgba(201,162,39,.28) !important; transform: translateY(-3px) !important;}\n.goth-card .sel-check{position: absolute !important; top: 8px !important; left: 8px !important; z-index: 4 !important;}\n.goth-card .cover-edit-btn{position: absolute !important; top: 8px !important; right: 8px !important; z-index: 4 !important; background:rgba(8,6,10,.8) !important; color:var(--g-gold) !important; border:1px solid var(--g-line) !important; border-radius:4px !important;}\n\n/* —— 6. 徽章 / 标签 —— */\n.badge, .card-tag{background:rgba(201,162,39,.10) !important; border:1px solid var(--g-line) !important; color:var(--g-gold) !important; border-radius:3px !important;}\n\n/* —— 7. 按钮：黑铁 + 金边，血红主按钮 —— */\n.btn, button{background:linear-gradient(180deg, #241318, #150b0d) !important; border:1px solid var(--g-gold) !important; color:var(--g-gold) !important; font-family:inherit !important; border-radius:5px !important; letter-spacing:.6px !important; transition:background .2s, box-shadow .2s, transform .15s, color .2s !important;}\n.btn:hover, button:hover{background:linear-gradient(180deg, #361a1f, #221012) !important; box-shadow:0 0 18px rgba(201,162,39,.45), 0 0 2px var(--g-gold) !important; transform: translateY(-1px) !important; color:var(--g-gold-hi) !important;}\n.btn:active, button:active{transform: translateY(0) !important;}\n.btn-primary, .btn-accent{background:linear-gradient(180deg, var(--g-blood-hi), var(--g-blood)) !important; border-color:#c0392b !important; color:#f3e3d0 !important;}\n.btn-primary:hover, .btn-accent:hover{background:linear-gradient(180deg, #d23434, var(--g-blood-hi)) !important; box-shadow:0 0 22px rgba(178,34,34,.6) !important; color:#fff !important;}\n/* 顶栏工具按钮悬停微光 */\n.topbar .btn:hover, .topbar button:hover{box-shadow:0 0 14px rgba(201,162,39,.4) !important;}\n\n/* —— 8. 弹窗：暗紫黑 + 金边 + 拱顶 —— */\n.modal, #modalBody, .modal-card{background:linear-gradient(160deg, #171120, #0b0813) !important; border:1px solid var(--g-gold) !important; color:var(--g-ink) !important; border-radius:10px !important; box-shadow:0 0 50px rgba(0,0,0,.85) !important;}\n.modal h1, .modal h2, .modal h3, #modalBody h1, #modalBody h2, #modalBody h3{color:var(--g-gold-hi) !important; font-family:'Cinzel','Songti SC',serif !important; letter-spacing:1.5px !important; text-align:center !important;}\n.modal h2::after, #modalBody h2::after{content: '' !important; display: block !important; height: 2px !important; margin-top: 8px !important; background: linear-gradient(90deg, transparent, var(--g-gold), transparent) !important;}\n\n/* —— 9. 输入控件 —— */\ninput, textarea, select{background:#0e0b13 !important; border:1px solid var(--g-line) !important; color:var(--g-ink) !important; border-radius:5px !important;}\ninput:focus, textarea:focus, select:focus{border-color:var(--g-gold) !important; box-shadow:0 0 10px rgba(201,162,39,.35) !important;}\n\n/* —— 10. 滚动条：暗金 —— */\n::-webkit-scrollbar{width:13px !important; height:13px !important;}\n::-webkit-scrollbar-track{background:#08070a !important;}\n::-webkit-scrollbar-thumb{background: linear-gradient(180deg, #4a3a1a, #2a2010) !important; border: 1px solid var(--g-gold) !important; border-radius:7px !important;}\n::-webkit-scrollbar-thumb:hover{background: var(--g-gold) !important;}\n\n/* —— 11. 金额总计条：石牌 + 金边 + 纹章 —— */\n.total-price-bar{background:linear-gradient(180deg, #1a1322, #0b0810) !important; border:1px solid var(--g-gold) !important; border-top:2px solid var(--g-gold-hi) !important; border-radius:8px !important; color:var(--g-ink) !important; font-family:'Cinzel','Songti SC','STSong',serif !important; letter-spacing:.5px !important; box-shadow:0 2px 16px rgba(0,0,0,.7), inset 0 0 12px rgba(201,162,39,.08) !important; padding:8px 16px !important; transition:box-shadow .25s, border-color .25s !important;}\n.total-price-bar::before{content: '⚜ ' !important; color: var(--g-gold-hi) !important; margin-right: 4px !important;}\n.total-price-bar:hover{border-color:var(--g-gold-hi) !important; box-shadow:0 2px 20px rgba(0,0,0,.8), inset 0 0 16px rgba(201,162,39,.16), 0 0 14px rgba(201,162,39,.25) !important;}\n.total-price-bar .sel-amt{color:var(--g-gold-hi) !important;}\n.total-price-bar .unpaid{color:var(--g-blood-hi) !important; text-shadow:0 0 8px rgba(178,34,34,.6) !important; font-weight:700 !important;}\n\n/* —— 12. 全局悬停 / 焦点点缀 —— */\n.tool-btn, .fav-tag-chip{transition:background .2s, color .2s, box-shadow .2s, transform .15s !important;}\n.tool-btn:hover{background:rgba(201,162,39,.14) !important; color:var(--g-gold-hi) !important; box-shadow:0 0 12px rgba(201,162,39,.3) !important;}\na:hover{color:var(--g-gold-hi) !important; text-shadow: 0 0 8px rgba(201,162,39,.4) !important;}\n\n/* 哥特卡片悬停再强化 */\n.goth-card:hover{box-shadow:0 0 0 1px var(--g-gold-hi), 0 0 40px rgba(201,162,39,.35) !important; transform: translateY(-4px) !important;}\n.goth-card:hover .goth-arch img{filter:sepia(.12) contrast(1.1) brightness(1) saturate(1) !important;}\n\n/* —— 13. 选中文本 + 全局标题 —— */\n::selection{background:rgba(122,14,14,.7) !important; color:#f3e3d0 !important;}\nh1, h2, h3, h4, .title{font-family:'Cinzel','Songti SC','STSong',serif !important; color:var(--g-gold-hi) !important; letter-spacing:1px !important;}",
    "customHtml": "<template data-slot=\"card\">\n  <div class=\"goth-card\">\n    {{selBox}}\n    <div class=\"goth-arch\">{{cover}}</div>\n    <div class=\"goth-title\">{{title}}</div>\n    <div class=\"goth-meta\">✦ {{author}} · {{price}}</div>\n    <div class=\"goth-tags\">{{tags}}</div>\n    {{coverEditBtn}}\n  </div>\n</template>"
  },
  "exportedAt": "2026-08-05T14:54:56.049Z"
}