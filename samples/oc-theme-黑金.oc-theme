{
  "ocUiTheme": 1,
  "schema": 3,
  "name": "哥特",
  "base": "dark",
  "builtin": false,
  "config": {
    "colors": {
      "bg": "#11100e",
      "surface": "#000000",
      "surface-hover": "#f3ede3",
      "surface-2": "#f3ede3",
      "surface-3": "#ebe2d4",
      "border": "#e7ddcb",
      "border-strong": "#d9c9ad",
      "text": "#2c251c",
      "text-secondary": "#6c6051",
      "text-2": "#6c6051",
      "text-3": "#9a8c77",
      "accent": "#c8854e",
      "accent-dark": "#b06a33",
      "accent-strong": "#b06a33",
      "accent-light": "#f7e9da",
      "accent-soft": "#f7e9da",
      "accent-soft-2": "#f1dcc6",
      "on-accent": "#ffffff",
      "success": "#5f9a6b",
      "success-soft": "#e3f0e6",
      "warning": "#cf9a3c",
      "warning-soft": "#f8ecd2",
      "danger": "#cf6b5a",
      "danger-soft": "#f7e0db",
      "info": "#5b87a8",
      "info-soft": "#e1ecf3",
      "cp": "#2a7d68",
      "cp-soft": "#e8f1ef",
      "cp-border": "#bfe0d6",
      "cp-fg": "#ffffff",
      "scrim": "#000000",
      "cal-heat-1": "#3a2e25",
      "cal-heat-2": "#554233",
      "cal-heat-3": "#765941",
      "cal-heat-4": "#a97e5b",
      "cal-heat-5": "#be9b7f",
      "cal-heat-1-fg": "#ffffff",
      "cal-heat-2-fg": "#ffffff",
      "cal-heat-3-fg": "#ffffff",
