    },
    "layout": {
      "fontScale": 100,
      "zoom": 100,
      "hoverAnim": true,
      "sidebarW": 280,
      "btnStyle": "solid",
      "scrollbar": true,
      "motion": true,
      "lightbox": "rgba(0,0,0,0.6)",
      "mobileGlass": false,
      "mobileMotion": false,
      "scrollbarColor": "#808080"
    },
    "artStyle": "default",
    "layoutRules": {
      "cardStyle": "overlay",
      "sidebarPos": "left",
      "showTopbar": true,
      "showSidebar": true,
      "showTotalBar": true,
      "showFilterBar": true,
      "lowPerf": false
