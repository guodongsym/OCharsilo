{
  "ocUiTheme": 1,
  "schema": 3,
  "name": "杂志编辑",
  "base": "light",
  "builtin": true,
  "config": {
    "colors": {
      "bg": "#f6f2f1",
      "surface": "#fefefd",
      "surface-hover": "#f2edeb",
      "surface-2": "#f2edeb",
      "surface-3": "#e8dedb",
      "border": "#e1d6d3",
      "border-strong": "#ceb9b3",
      "text": "#261d1a",
      "text-secondary": "#745e58",
      "text-2": "#745e58",
      "text-3": "#98847e",
      "accent": "#b4482a",
      "accent-dark": "#a03d22",
      "accent-strong": "#a03d22",
      "accent-light": "#f2e1dc",
      "accent-soft": "#f2e1dc",
      "accent-soft-2": "#ebd0c9",
      "on-accent": "#ffffff",
      "success": "#498361",
      "success-soft": "#e6ede9",
      "warning": "#ab852b",
      "warning-soft": "#f1ede1",
      "danger": "#c94936",
      "danger-soft": "#f1e4e2",
      "info": "#457292",
      "info-soft": "#e4eaee",
      "cp": "#2a7d68",
      "cp-soft": "#e8f1ef",
      "cp-border": "#bfe0d6",
      "cp-fg": "#ffffff",
      "scrim": "#000000",
      "cal-heat-1": "#f2eae8",
      "cal-heat-2": "#e7d1cb",
      "cal-heat-3": "#daaea2",
      "cal-heat-4": "#ce7f69",
      "cal-heat-5": "#b64f32",
      "cal-heat-1-fg": "#1a1410",
      "cal-heat-2-fg": "#1a1410",
      "cal-heat-3-fg": "#1a1410",
      "cal-heat-4-fg": "#1a1410",
      "cal-heat-5-fg": "#ffffff"
    },
    "radius": {
      "lg": 16,
      "md": 12,
      "sm": 8,
      "xs": 6,
      "pill": 999,
      "square": false
    },
    "texture": {
      "shadow": "md",
      "shadowOn": true,
      "glass": false,
      "glassBlur": 12,
      "borderW": 1
    },
    "layout": {
      "fontScale": 100,
      "zoom": 100,
      "hoverAnim": true,
      "sidebarW": 280,
      "btnStyle": "soft",
      "scrollbar": true,
      "motion": true,
      "lightbox": "rgba(0,0,0,0.6)",
      "mobileGlass": false,
      "mobileMotion": false,
      "scrollbarColor": "#808080"
    },
    "artStyle": "default",
    "layoutRules": {
      "cardStyle": "overlay",
      "sidebarPos": "left",
      "showTopbar": true,
      "showSidebar": true,
      "showTotalBar": true,
      "showFilterBar": true,
      "lowPerf": false
    },
    "designMode": "free",
    "customCss": "/* ===== 杂志编辑风 · 全套主题 ===== */\n[data-design-mode=\"free\"], [data-ai-theme]{--bg:#f5f1e8 !important; --surface:#fffdf8 !important; --text:#1a1917 !important; --accent:#b4482a !important; --border:#d9d0bd !important; --r-lg:2px !important; --r-md:1px !important; --shadow:0 1px 3px rgba(30,25,20,.08) !important; font-family:\"Iowan Old Style\",\"Baskerville\",\"Songti SC\",\"STSong\",Georgia,serif !important; letter-spacing: .01em !important;}\nbody[data-design-mode=\"free\"]{background:var(--bg) !important; color:var(--text) !important;}\n[data-design-mode=\"free\"] body{background:var(--bg) !important;}\n\n/* ===== 背景纹理：纸张纤维感 ===== */\n[data-design-mode=\"free\"] body,\n[data-design-mode=\"free\"] .app,\n[data-design-mode=\"free\"] .main-area{background-image:\n    linear-gradient(0deg, rgba(180,72,42,.012) 1px, transparent 1px),\n    linear-gradient(90deg, rgba(180,72,42,.008) 1px, transparent 1px),\n    radial-gradient(ellipse at 20% 20%, rgba(255,250,235,.6), transparent 60%),\n    radial-gradient(ellipse at 80% 80%, rgba(210,190,150,.15), transparent 50%) !important; background-size:4px 4px,4px 4px,100% 100%,100% 100% !important;}\n\n/* ===== 顶栏 ===== */\n[data-design-mode=\"free\"] .topbar{background:#fffdf8 !important; border-bottom:2px solid var(--text) !important; box-shadow:0 2px 0 var(--accent) !important; font-family:\"Helvetica Neue\",Arial,\"PingFang SC\",sans-serif !important; letter-spacing:.08em !important; min-height:56px !important;}\n[data-design-mode=\"free\"] .topbar a,\n[data-design-mode=\"free\"] .topbar button{font-size:11px !important; text-transform:uppercase !important; letter-spacing:.12em !important; color:var(--text) !important; font-weight:700 !important; border-radius:0 !important;}\n[data-design-mode=\"free\"] .topbar a:hover,\n[data-design-mode=\"free\"] .topbar button:hover{color:var(--accent) !important; border-bottom:2px solid var(--accent) !important;}\n\n/* ===== 侧栏 ===== */\n[data-design-mode=\"free\"] .sidebar{background:#efe9dc !important; border-right:1px solid var(--border) !important; font-family:\"Helvetica Neue\",Arial,\"PingFang SC\",sans-serif !important;}\n[data-design-mode=\"free\"] .side-head{font-family:\"Iowan Old Style\",Georgia,serif !important; font-style:italic !important; font-size:22px !important; border-bottom:1px solid var(--text) !important; padding:18px 16px !important; letter-spacing:.02em !important;}\n[data-design-mode=\"free\"] .sidebar a,\n[data-design-mode=\"free\"] .sidebar .nav-item{font-size:12px !important; font-weight:600 !important; letter-spacing:.06em !important; text-transform:uppercase !important; border-left:3px solid transparent !important; transition:all .15s ease !important; padding:10px 16px !important;}\n[data-design-mode=\"free\"] .sidebar a:hover{border-left-color:var(--accent) !important; background:rgba(180,72,42,.06) !important;}\n[data-design-mode=\"free\"] .sidebar a.active{border-left-color:var(--accent) !important; background:#fffdf8 !important; color:var(--accent) !important; box-shadow:inset 0 -1px 0 var(--text) !important;}\n\n/* ===== 画廊容器 ===== */\n[data-design-mode=\"free\"] .gallery-grid{gap:24px 20px !important; padding:32px 28px !important;}\n\n/* ===== 卡片 ===== */\n[data-design-mode=\"free\"] .art-card{background:#fffdf8 !important; border:1px solid var(--border) !important; border-radius:2px !important; box-shadow:none !important; transition:box-shadow .2s ease, transform .2s ease !important; overflow:visible !important;}\n[data-design-mode=\"free\"] .art-card:hover{box-shadow:4px 4px 0 rgba(26,25,23,.9) !important; transform:translate(-2px,-2px) !important; border-color:var(--text) !important;}\n\n/* 卡片封面区域 */\n[data-design-mode=\"free\"] .art-card .thumb{border-radius:0 !important; border-bottom:1px solid var(--border) !important;}\n[data-design-mode=\"free\"] .thumb-overlay{background:linear-gradient(180deg, transparent 40%, rgba(26,25,23,.75)) !important;}\n[data-design-mode=\"free\"] .art-card:hover .thumb-overlay{background:linear-gradient(180deg, rgba(180,72,42,.15), rgba(180,72,42,.35)) !important;}\n\n/* 卡片标题：杂志黑体 */\n[data-design-mode=\"free\"] .thumb-title{font-family:\"Iowan Old Style\",Georgia,serif !important; font-size:19px !important; font-weight:800 !important; line-height:1.25 !important; letter-spacing:.01em !important; color:var(--text) !important; padding:14px 16px 4px !important;}\n[data-design-mode=\"free\"] .thumb-title::after{content:\"\" !important; display:block !important; width:32px !important; height:3px !important; background:var(--accent) !important; margin-top:8px !important;}\n\n/* 标签行：杂志版式 — 用 # 分隔 */\n[data-design-mode=\"free\"] .card-tags{display:flex !important; flex-wrap:wrap !important; gap:6px 10px !important; padding:8px 16px 14px !important; font-family:\"Helvetica Neue\",Arial,sans-serif !important;}\n[data-design-mode=\"free\"] .card-tags .tag{font-size:9px !important; text-transform:uppercase !important; letter-spacing:.14em !important; background:transparent !important; border:1px solid var(--border) !important; color:var(--text) !important; padding:3px 8px !important; border-radius:0 !important; font-weight:600 !important;}\n[data-design-mode=\"free\"] .card-tags .tag:hover{background:var(--text) !important; color:#fffdf8 !important;}\n\n/* 徽章 */\n[data-design-mode=\"free\"] .badge{font-family:\"Helvetica Neue\",Arial,sans-serif !important; font-size:9px !important; text-transform:uppercase !important; letter-spacing:.12em !important; border-radius:0 !important; border:1px solid var(--text) !important; background:#fffdf8 !important; color:var(--text) !important; padding:4px 8px !important;}\n[data-design-mode=\"free\"] .badge-accent{background:var(--accent) !important; border-color:var(--accent) !important; color:#fffdf8 !important;}\n\n/* 评分星 */\n[data-design-mode=\"free\"] .star-ic{color:#c4930a !important; font-size:13px !important;}\n[data-design-mode=\"free\"] .thumb-price{font-family:\"Iowan Old Style\",Georgia,serif !important; font-size:16px !important; font-weight:700 !important; color:var(--accent) !important; font-style:italic !important;}\n[data-design-mode=\"free\"] .thumb-unpaid{font-family:\"Helvetica Neue\",Arial,sans-serif !important; font-size:9px !important; text-transform:uppercase !important; letter-spacing:.1em !important; background:var(--text) !important; color:#fffdf8 !important; padding:3px 8px !important;}\n\n/* ===== 内容头 ===== */\n[data-design-mode=\"free\"] .content-header{border-bottom:3px double var(--text) !important; padding:24px 28px 16px !important; margin-bottom:8px !important; font-family:\"Iowan Old Style\",Georgia,serif !important;}\n[data-design-mode=\"free\"] .content-header h1,\n[data-design-mode=\"free\"] .content-header h2{font-size:32px !important; font-weight:900 !important; letter-spacing:.01em !important; font-family:inherit !important;}\n[data-design-mode=\"free\"] .content-header p{font-style:italic !important; color:#555 !important;}\n\n/* ===== 按钮 ===== */\n[data-design-mode=\"free\"] .btn{font-family:\"Helvetica Neue\",Arial,sans-serif !important; font-size:11px !important; font-weight:700 !important; text-transform:uppercase !important; letter-spacing:.14em !important; background:#fffdf8 !important; color:var(--text) !important; border:1.5px solid var(--text) !important; border-radius:0 !important; padding:8px 18px !important; box-shadow:none !important; transition:all .15s ease !important; cursor:pointer !important;}\n[data-design-mode=\"free\"] .btn:hover{background:var(--text) !important; color:#fffdf8 !important; transform:translateY(-1px) !important; box-shadow:3px 3px 0 var(--accent) !important;}\n[data-design-mode=\"free\"] .btn.primary{background:var(--accent) !important; border-color:var(--accent) !important; color:#fffdf8 !important;}\n[data-design-mode=\"free\"] .btn.primary:hover{background:var(--text) !important; border-color:var(--text) !important; box-shadow:3px 3px 0 var(--accent) !important;}\n[data-design-mode=\"free\"] .btn:active{transform:translate(1px,1px) !important; box-shadow:none !important;}\n[data-design-mode=\"free\"] .btn:disabled{opacity:.4 !important; cursor:not-allowed !important; transform:none !important; box-shadow:none !important;}\n\n/* ===== 弹窗 ===== */\n[data-design-mode=\"free\"] .modal{border-radius:2px !important; border:1px solid var(--text) !important; box-shadow:8px 8px 0 rgba(26,25,23,.2) !important; background:#fffdf8 !important;}\n[data-design-mode=\"free\"] .modal-header{font-family:\"Iowan Old Style\",Georgia,serif !important; font-size:22px !important; font-weight:800 !important; border-bottom:2px solid var(--text) !important; padding:16px 20px !important;}\n[data-design-mode=\"free\"] .modal-body{padding:20px !important; font-family:\"Helvetica Neue\",Arial,sans-serif !important; font-size:14px !important;}\n[data-design-mode=\"free\"] .modal-footer{border-top:1px solid var(--border) !important; padding:14px 20px !important; display:flex !important; gap:10px !important; justify-content:flex-end !important;}\n\n/* ===== 编辑面板 ===== */\n[data-design-mode=\"free\"] .edit-panel{background:#fffdf8 !important; border:1px solid var(--border) !important; border-radius:2px !important;}\n[data-design-mode=\"free\"] .edit-panel-header{font-family:\"Iowan Old Style\",Georgia,serif !important; font-weight:800 !important; border-bottom:1px solid var(--text) !important; padding:14px 18px !important; font-size:18px !important;}\n[data-design-mode=\"free\"] .edit-panel label{font-family:\"Helvetica Neue\",Arial,sans-serif !important; font-size:11px !important; text-transform:uppercase !important; letter-spacing:.1em !important; font-weight:700 !important; color:#444 !important;}\n\n/* ===== 表单 ===== */\n[data-design-mode=\"free\"] input,\n[data-design-mode=\"free\"] select,\n[data-design-mode=\"free\"] textarea{font-family:\"Helvetica Neue\",Arial,\"PingFang SC\",sans-serif !important; font-size:14px !important; background:#fffdf8 !important; color:var(--text) !important; border:1px solid var(--border) !important; border-radius:0 !important; padding:8px 12px !important; outline:none !important; transition:border-color .15s ease, box-shadow .15s ease !important;}\n[data-design-mode=\"free\"] input:focus,\n[data-design-mode=\"free\"] select:focus,\n[data-design-mode=\"free\"] textarea:focus{border-color:var(--accent) !important; box-shadow:0 0 0 1px var(--accent) !important;}\n\n/* ===== 总计条 ===== */\n[data-design-mode=\"free\"] .total-price-bar{background:#fffdf8 !important; border-top:2px solid var(--text) !important; box-shadow:0 -2px 0 var(--accent) !important; font-family:\"Helvetica Neue\",Arial,sans-serif !important; padding:14px 24px !important; text-transform:uppercase !important; letter-spacing:.08em !important; font-size:12px !important;}\n[data-design-mode=\"free\"] .total-price-bar .total-price{font-family:\"Iowan Old Style\",Georgia,serif !important; font-size:24px !important; font-weight:900 !important; font-style:italic !important; color:var(--accent) !important;}\n\n/* ===== 选中态 ===== */\n[data-design-mode=\"free\"] .art-card.selected{outline:2px solid var(--accent) !important; outline-offset:2px !important; border-color:var(--accent) !important; box-shadow:4px 4px 0 rgba(180,72,42,.35) !important;}\n[data-design-mode=\"free\"] .selected .thumb-title::after{background:var(--text) !important; transform:scaleX(1.5) !important;}\n\n/* 自定义卡片结构 */\n[data-design-mode=\"free\"] .mag-card{background:#fffdf8 !important; border:1px solid var(--border) !important; position:relative !important; transition:box-shadow .2s ease, transform .2s ease !important;}\n[data-design-mode=\"free\"] .mag-card:hover{box-shadow:6px 6px 0 rgba(26,25,23,.85) !important; transform:translate(-2px,-2px) !important; border-color:var(--text) !important;}\n[data-design-mode=\"free\"] .mag-card.selected{outline:2px solid var(--accent) !important; outline-offset:2px !important;}\n[data-design-mode=\"free\"] .mag-cover{position:relative !important; border-bottom:2px solid var(--text) !important; overflow:hidden !important;}\n[data-design-mode=\"free\"] .mag-cover .thumb{width:100% !important; aspect-ratio:4/3 !important; object-fit:cover !important; display:block !important;}\n[data-design-mode=\"free\"] .mag-issue{position:absolute !important; top:12px !important; left:-28px !important; background:var(--accent) !important; color:#fffdf8 !important; font-family:\"Helvetica Neue\",Arial,sans-serif !important; font-size:8px !important; font-weight:800 !important; text-transform:uppercase !important; letter-spacing:.18em !important; padding:4px 32px !important; transform:rotate(-45deg) !important; z-index:3 !important; box-shadow:0 1px 2px rgba(0,0,0,.2) !important;}\n[data-design-mode=\"free\"] .mag-body{padding:0 !important;}\n[data-design-mode=\"free\"] .mag-meta{display:flex !important; align-items:center !important; justify-content:space-between !important; font-family:\"Helvetica Neue\",Arial,sans-serif !important; font-size:9px !important; text-transform:uppercase !important; letter-spacing:.12em !important; color:#555 !important; padding:14px 16px 0 !important;}\n[data-design-mode=\"free\"] .mag-title{font-family:\"Iowan Old Style\",Georgia,serif !important; font-size:21px !important; font-weight:900 !important; line-height:1.2 !important; padding:6px 16px 0 !important; letter-spacing:-.01em !important; color:var(--text) !important;}\n[data-design-mode=\"free\"] .mag-title::after{content:\"\" !important; display:block !important; width:28px !important; height:3px !important; background:var(--accent) !important; margin-top:8px !important;}\n[data-design-mode=\"free\"] .mag-desc{font-family:\"Helvetica Neue\",Arial,sans-serif !important; font-size:11px !important; line-height:1.6 !important; color:#555 !important; padding:8px 16px 0 !important;}\n[data-design-mode=\"free\"] .mag-tags{display:flex !important; flex-wrap:wrap !important; gap:5px 8px !important; padding:10px 16px 0 !important;}\n[data-design-mode=\"free\"] .mag-tags span{font-family:\"Helvetica Neue\",Arial,sans-serif !important; font-size:8px !important; text-transform:uppercase !important; letter-spacing:.12em !important; border:1px solid var(--border) !important; color:#444 !important; padding:2px 6px !important; background:transparent !important;}\n[data-design-mode=\"free\"] .mag-foot{display:flex !important; align-items:center !important; justify-content:space-between !important; padding:12px 16px 14px !important; border-top:1px dotted var(--border) !important; margin-top:12px !important;}\n[data-design-mode=\"free\"] .mag-price{font-family:\"Iowan Old Style\",Georgia,serif !important; font-size:18px !important; font-weight:800 !important; font-style:italic !important; color:var(--accent) !important;}\n[data-design-mode=\"free\"] .mag-author{font-family:\"Helvetica Neue\",Arial,sans-serif !important; font-size:9px !important; text-transform:uppercase !important; letter-spacing:.12em !important; color:#666 !important;}\n[data-design-mode=\"free\"] .mag-sel{position:absolute !important; top:10px !important; left:10px !important; z-index:5 !important;}\n[data-design-mode=\"free\"] .mag-sel input[type=checkbox]{width:18px !important; height:18px !important; accent-color:var(--accent) !important; cursor:pointer !important;}\n[data-design-mode=\"free\"] .mag-editbtn{opacity:0 !important; position:absolute !important; bottom:10px !important; right:10px !important; background:rgba(26,25,23,.85) !important; color:#fffdf8 !important; border:none !important; width:30px !important; height:30px !important; border-radius:50% !important; font-size:14px !important; cursor:pointer !important; transition:opacity .15s ease !important; display:flex !important; align-items:center !important; justify-content:center !important;}\n[data-design-mode=\"free\"] .mag-card:hover .mag-editbtn{opacity:1 !important;}\n\n/* 日历卡 */\n[data-design-mode=\"free\"] .cal-day-card{border-radius:2px !important; border:1px solid var(--border) !important; font-family:\"Helvetica Neue\",Arial,sans-serif !important;}\n[data-design-mode=\"free\"] .cal-day-card:hover{border-color:var(--text) !important; box-shadow:2px 2px 0 rgba(26,25,23,.5) !important;}\n[data-design-mode=\"free\"] .cal-day-card.today{box-shadow:inset 0 -3px 0 var(--accent) !important; border-color:var(--accent) !important;}\n\n/* OC卡 / 世界观卡 */\n[data-design-mode=\"free\"] .oc-card,\n[data-design-mode=\"free\"] .wv-card{border-radius:2px !important; border:1px solid var(--border) !important; background:#fffdf8 !important; transition:box-shadow .2s, transform .2s !important;}\n[data-design-mode=\"free\"] .oc-card:hover,\n[data-design-mode=\"free\"] .wv-card:hover{box-shadow:4px 4px 0 rgba(26,25,23,.8) !important; transform:translate(-1px,-1px) !important;}\n\n/* 筛选触发/工具栏 */\n[data-design-mode=\"free\"] .filter-trigger,\n[data-design-mode=\"free\"] .view-toolbar{font-family:\"Helvetica Neue\",Arial,sans-serif !important; text-transform:uppercase !important; letter-spacing:.1em !important; font-size:11px !important; font-weight:700 !important; background:transparent !important; border:1px solid var(--border) !important;}\n[data-design-mode=\"free\"] .filter-trigger:hover,\n[data-design-mode=\"free\"] .view-toolbar:hover{border-color:var(--text) !important;}\n\n/* 滚动条美化 */\n[data-design-mode=\"free\"] ::-webkit-scrollbar{width:10px !important; height:10px !important;}\n[data-design-mode=\"free\"] ::-webkit-scrollbar-track{background:var(--bg) !important;}\n[data-design-mode=\"free\"] ::-webkit-scrollbar-thumb{background:#b8ad98 !important; border:2px solid var(--bg) !important; border-radius:0 !important;}\n[data-design-mode=\"free\"] ::-webkit-scrollbar-thumb:hover{background:var(--accent) !important;}\n\n/* 链接 */\n[data-design-mode=\"free\"] a{color:var(--accent) !important; text-decoration:none !important; border-bottom:1px dotted var(--accent) !important;}\n[data-design-mode=\"free\"] a:hover{color:var(--text) !important; border-bottom-style:solid !important;}\n\n/* ===== 动画 ===== */\n@keyframes magIn{from{opacity: 0 !important; transform: translateY(12px) !important; }\n  to{opacity: 1 !important; transform: translateY(0) !important; };}\n[data-design-mode=\"free\"] .art-card,\n[data-design-mode=\"free\"] .mag-card{animation:magIn .35s ease both !important;}\n\n/* ===== 下拉文本菜单 ===== */\n[data-design-mode=\"free\"] .dropdown-menu{font-family:\"Helvetica Neue\",Arial,sans-serif !important; border:1px solid var(--text) !important; border-radius:0 !important; box-shadow:4px 4px 0 rgba(26,25,23,.15) !important; background:#fffdf8 !important;}\n[data-design-mode=\"free\"] .dropdown-menu a:hover{background:var(--text) !important; color:#fffdf8 !important;}\n\n/* ===== [杂志编辑·精简+瀑布流+隐藏ID] ===== */\n/* 精简模式（body.compact-mode）：只显示图片，隐藏全部文字信息 */\n[data-ai-theme] body.compact-mode .mag-issue,\n[data-design-mode=\"free\"] body.compact-mode .mag-issue,\n[data-ai-theme] body.compact-mode .mag-body,\n[data-design-mode=\"free\"] body.compact-mode .mag-body{display:none!important;}\n/* 封面在精简模式下去掉内边距与文字叠层，仅留图片 */\n[data-ai-theme] body.compact-mode .mag-cover,\n[data-design-mode=\"free\"] body.compact-mode .mag-cover{padding:0!important; aspect-ratio:auto!important;}\n[data-ai-theme] body.compact-mode .mag-cover > div:not(.thumb),\n[data-design-mode=\"free\"] body.compact-mode .mag-cover > div:not(.thumb){display:none!important;}\n[data-ai-theme] body.compact-mode .mag-cover .thumb,\n[data-design-mode=\"free\"] body.compact-mode .mag-cover .thumb{aspect-ratio:auto!important; height:auto!important; object-fit:cover!important;}\n[data-ai-theme] body.compact-mode .mag-card,\n[data-design-mode=\"free\"] body.compact-mode .mag-card{min-height:0!important;}\n/* 瀑布流：恢复列式错落；封面按图片原始比例，不再裁成 4:3 */\n[data-ai-theme] .gallery-grid.view-masonry,\n[data-design-mode=\"free\"] .gallery-grid.view-masonry{display:block!important; column-gap:16px!important;}\n[data-ai-theme] .gallery-grid.view-masonry .art-card,\n[data-design-mode=\"free\"] .gallery-grid.view-masonry .art-card{display:inline-block!important; width:100%!important; margin-bottom:18px!important; break-inside:avoid!important; aspect-ratio:auto!important; height:auto!important;}\n[data-ai-theme] .gallery-grid.view-masonry .mag-cover .thumb,\n[data-design-mode=\"free\"] .gallery-grid.view-masonry .mag-cover .thumb{width:100%!important; height:auto!important; aspect-ratio:auto!important; display:block!important;}\n\n/* ===== [杂志编辑·网格去空白+标签杂志风+OC fallback] ===== */\n/* 1. 网格模式下卡片高度由内容决定，不要拉伸出多余空白 */\n[data-ai-theme] .gallery-grid:not(.view-masonry) .art-card,\n[data-design-mode=\"free\"] .gallery-grid:not(.view-masonry) .art-card{align-self:start!important; height:fit-content!important;}\n\n/* 2. 标签杂志风：无背景、底部短红线、小字大写 */\n[data-ai-theme] .mag-tags span,\n[data-design-mode=\"free\"] .mag-tags span{font-family:'Helvetica Neue',Arial,sans-serif!important; font-size:9px!important; text-transform:uppercase!important; letter-spacing:.12em!important; color:#555!important; background:transparent!important; border:none!important; padding:0 0 4px 0!important; position:relative!important; margin-right:8px!important;}\n[data-ai-theme] .mag-tags span::after,\n[data-design-mode=\"free\"] .mag-tags span::after{content:\"\"!important; position:absolute!important; bottom:0!important; left:0!important; width:12px!important; height:2px!important; background:var(--accent)!important;}\n\n/* 3. 左上角徽标：没有关联 OC 时显示 \"OC\" */\n[data-ai-theme] .mag-oc-default,\n[data-design-mode=\"free\"] .mag-oc-default{display:none!important;}\n[data-ai-theme] .mag-oc-real:empty ~ .mag-oc-default,\n[data-design-mode=\"free\"] .mag-oc-real:empty ~ .mag-oc-default{display:inline!important;}\n\n/* ===== [杂志编辑·精简模式网格修复] =====\n   网格视图下开启精简模式时，卡片应只剩图片，不要边框/背景/底部黑线/多余空白 */\n[data-ai-theme] body.compact-mode .gallery-grid:not(.view-masonry) .mag-card,\n[data-design-mode=\"free\"] body.compact-mode .gallery-grid:not(.view-masonry) .mag-card{padding:0!important; border:none!important; background:transparent!important; box-shadow:none!important; min-height:0!important;}\n[data-ai-theme] body.compact-mode .gallery-grid:not(.view-masonry) .mag-cover,\n[data-design-mode=\"free\"] body.compact-mode .gallery-grid:not(.view-masonry) .mag-cover{border-bottom:none!important; border-radius:0!important;}\n[data-ai-theme] body.compact-mode .gallery-grid:not(.view-masonry) .mag-cover .thumb,\n[data-design-mode=\"free\"] body.compact-mode .gallery-grid:not(.view-masonry) .mag-cover .thumb{border-radius:0!important; margin:0!important;}\n\n/* ===== [杂志编辑·精简模式网格·统一正方形] =====\n   网格视图 + 精简模式：所有图片裁切为大小统一的正方形。\n   卡片锁 aspect-ratio:1/1（列宽由网格统一，故每张等高）；\n   封面与缩略图铺满卡片，object-fit:cover 居中裁切，无白边、尺寸一致。 */\n[data-ai-theme] body.compact-mode .gallery-grid:not(.view-masonry) .art-card,\n[data-design-mode=\"free\"] body.compact-mode .gallery-grid:not(.view-masonry) .art-card{aspect-ratio:1/1!important; height:auto!important; align-self:stretch!important;}\n[data-ai-theme] body.compact-mode .gallery-grid:not(.view-masonry) .mag-card,\n[data-design-mode=\"free\"] body.compact-mode .gallery-grid:not(.view-masonry) .mag-card{display:block!important; width:100%!important; height:100%!important; min-height:0!important; padding:0!important; border:none!important; background:transparent!important; box-shadow:none!important;}\n[data-ai-theme] body.compact-mode .gallery-grid:not(.view-masonry) .mag-cover,\n[data-design-mode=\"free\"] body.compact-mode .gallery-grid:not(.view-masonry) .mag-cover{width:100%!important; height:100%!important; border-bottom:none!important; border-radius:0!important;}\n[data-ai-theme] body.compact-mode .gallery-grid:not(.view-masonry) .mag-cover .thumb,\n[data-design-mode=\"free\"] body.compact-mode .gallery-grid:not(.view-masonry) .mag-cover .thumb{width:100%!important; height:100%!important; aspect-ratio:auto!important; object-fit:cover!important; display:block!important; margin:0!important; border-radius:0!important;}",
    "customHtml": "<template data-slot=\"card\">\n  <div class=\"mag-card\">\n    <div class=\"mag-sel\">{{selBox}}</div>\n    <div class=\"mag-issue\"><span class=\"mag-issue-prefix\">✦ </span><span class=\"mag-oc-real\">{{chars}}</span><span class=\"mag-oc-default\">OC</span></div>\n    <div class=\"mag-cover\">\n      {{cover}}\n      <div style=\"position:absolute;bottom:8px;left:12px;right:12px;display:flex;justify-content:space-between;align-items:flex-end;\">\n        <div style=\"font-family:'Helvetica Neue',Arial,sans-serif;font-size:9px;text-transform:uppercase;letter-spacing:.15em;color:rgba(255,253,248,.9);font-weight:700;\">{{type}}</div>\n        <div style=\"font-family:'Helvetica Neue',Arial,sans-serif;font-size:9px;text-transform:uppercase;letter-spacing:.1em;color:rgba(255,253,248,.9);background:rgba(26,25,23,.55);padding:2px 8px;\">{{imgN}}</div>\n      </div>\n      {{coverEditBtn}}\n    </div>\n    <div class=\"mag-body\">\n      <div class=\"mag-meta\">\n        <span style=\"display:inline-flex;align-items:center;gap:4px;\">{{rating}}</span>\n        <span>{{author}}</span>\n      </div>\n      <h3 class=\"mag-title\">{{title}}</h3>\n      <div class=\"mag-desc\">\n        {{rights}} · {{duration}} · {{software}}\n      </div>\n      <div class=\"mag-tags\">\n        {{tags}}\n      </div>\n      <div class=\"mag-foot\">\n        <span class=\"mag-price\">{{price}}{{unpaid}}</span>\n        <span class=\"mag-author\">{{fileN}}附件</span>\n      </div>\n    </div>\n  </div>\n</template>",
    "spacing": {
      "base": 8,
      "scale": 1
    },
    "font": {
      "family": "system"
    },
    "layoutMap": {},
    "iconMode": "emoji",
    "iconFontUrl": "",
    "customIcons": {}
  },
  "exportedAt": "2026-08-11T03:24:40.689Z"
}