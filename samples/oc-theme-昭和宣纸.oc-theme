{
  "ocUiTheme": 1,
  "schema": 3,
  "name": "昭和宣纸",
  "base": "light",
  "builtin": true,
  "config": {
    "colors": {
      "bg": "#f7f3ec",
      "surface": "#ffffff",
      "surface-hover": "#f3ede3",
      "surface-2": "#f3ede3",
      "surface-3": "#ebe2d4",
      "border": "#e7ddcb",
      "border-strong": "#d9c9ad",
      "text": "#2c251c",
      "text-secondary": "#6c6051",
      "text-2": "#6c6051",
      "text-3": "#9a8c77",
      "accent": "#b3423a",
      "accent-dark": "#b06a33",
      "accent-strong": "#b06a33",
      "accent-light": "#f7e9da",
      "accent-soft": "#f7e9da",
      "accent-soft-2": "#f1dcc6",
      "on-accent": "#ffffff",
      "success": "#5f9a6b",
      "success-soft": "#e3f0e6",
      "warning": "#cf9a3c",
      "warning-soft": "#f8ecd2",
      "danger": "#cf6b5a",
      "danger-soft": "#f7e0db",
      "info": "#5b87a8",
      "info-soft": "#e1ecf3",
      "cp": "#2a7d68",
      "cp-soft": "#e8f1ef",
      "cp-border": "#bfe0d6",
      "cp-fg": "#ffffff",
      "scrim": "#000000",
      "cal-heat-1": "#f1eae9",
      "cal-heat-2": "#e4cfcd",
      "cal-heat-3": "#d5aaa7",
      "cal-heat-4": "#c57772",
      "cal-heat-5": "#ab453e",
      "cal-heat-1-fg": "#1a1410",
      "cal-heat-2-fg": "#1a1410",
      "cal-heat-3-fg": "#1a1410",
      "cal-heat-4-fg": "#1a1410",
      "cal-heat-5-fg": "#ffffff"
    },
    "radius": {
      "lg": 16,
      "md": 12,
      "sm": 8,
      "xs": 6,
      "pill": 999,
      "square": false
    },
    "texture": {
      "shadow": "md",
      "shadowOn": true,
      "glass": false,
      "glassBlur": 12,
      "borderW": 1
    },
    "layout": {
      "fontScale": 100,
      "zoom": 100,
      "hoverAnim": true,
      "sidebarW": 280,
      "btnStyle": "solid",
      "scrollbar": true,
      "motion": true,
      "lightbox": "rgba(0,0,0,0.6)",
      "mobileGlass": false,
      "mobileMotion": false,
      "scrollbarColor": "#808080"
    },
    "artStyle": "default",
    "layoutRules": {
      "cardStyle": "overlay",
      "sidebarPos": "left",
      "showTopbar": true,
      "showSidebar": true,
      "showTotalBar": true,
      "showFilterBar": true,
      "lowPerf": false
    },
    "designMode": "free",
    "customCss": "/* ===== 日系古早 / 昭和宣纸 ===== */\n/* 基础基底 */\nbody[data-design-mode=\"free\"]{background-color:#f5e9d3 !important; background-image:repeating-linear-gradient(0deg, rgba(180,150,100,.04) 0px, rgba(180,150,100,.04) 1px, transparent 1px, transparent 4px),repeating-linear-gradient(90deg, rgba(180,150,100,.03) 0px, rgba(180,150,100,.03) 1px, transparent 1px, transparent 5px) !important; color:#3e2f2a !important; font-family:\"Hiragino Mincho ProN\",\"Yu Mincho\",\"MS PMincho\",\"Noto Serif JP\",serif !important;}\n\n[data-design-mode=\"free\"] .sidebar{background:#efe3c8 !important; border-right:4px solid #b3423a !important; box-shadow:inset -2px 0 0 rgba(179,66,58,.15) !important; font-family:\"Hiragino Sans\",\"Noto Sans JP\",sans-serif !important;}\n[data-design-mode=\"free\"] .side-head{background:#b3423a !important; color:#fdf6e3 !important; font-family:\"Hiragino Mincho ProN\",\"Yu Mincho\",serif !important; letter-spacing:.2em !important; text-shadow:2px 2px 2px rgba(0,0,0,.3) !important; border-bottom:2px solid #6e1f1a !important;}\n\n[data-design-mode=\"free\"] .topbar{background:#fdf6e3 !important; border-bottom:2px solid #b3423a !important; box-shadow:0 2px 4px rgba(179,66,58,.1) !important;}\n[data-design-mode=\"free\"] .topbar .btn{background:transparent !important; color:#3e2f2a !important; border:1px solid #b3423a !important;}\n\n/* 卡片 · 古早风 */\n[data-design-mode=\"free\"] .art-card{background:#fdf8ec !important; border:1px solid #c9b48a !important; border-radius:4px !important; box-shadow:0 2px 6px rgba(120,90,40,.15), 0 8px 16px rgba(120,90,40,.06) !important; position:relative !important; overflow:hidden !important; transition:transform .25s ease, box-shadow .25s ease !important;}\n[data-design-mode=\"free\"] .art-card::before{content:\"\" !important; position:absolute !important; top:0 !important; left:0 !important; right:0 !important; height:4px !important; background:repeating-linear-gradient(90deg,#b3423a 0 12px,#d6b98c 12px 16px) !important; z-index:3 !important; opacity:.8 !important;}\n[data-design-mode=\"free\"] .art-card:hover{transform:translateY(-3px) !important; box-shadow:0 6px 16px rgba(120,90,40,.25), 0 16px 30px rgba(120,90,40,.1) !important; border-color:#8a6b3c !important;}\n\n/* 封面 */\n[data-design-mode=\"free\"] .art-card .thumb{border-bottom:2px solid #c9b48a !important; background:#e8dcc2 !important;}\n[data-design-mode=\"free\"] .art-card .thumb img{filter:sepia(.15) contrast(.95) brightness(1.02) !important; transition:filter .3s !important;}\n[data-design-mode=\"free\"] .art-card:hover .thumb img{filter:sepia(.05) contrast(1) brightness(1) !important;}\n[data-design-mode=\"free\"] .art-card .thumb-overlay{background:linear-gradient(180deg, rgba(62,47,42,0) 30%, rgba(62,47,42,.55) 100%) !important;}\n[data-design-mode=\"free\"] .art-card .thumb-title{font-family:\"Hiragino Mincho ProN\",\"Yu Mincho\",serif !important; font-size:1.05em !important; color:#fdf6e3 !important; text-shadow:1px 1px 3px #000 !important; letter-spacing:.08em !important; padding:.35em .5em !important; border-left:3px solid #e9c46a !important; background:rgba(62,47,42,.2) !important;}\n\n/* 卡片内文字 */\n[data-design-mode=\"free\"] .art-card .card-tags{background:#f5ecd8 !important; border-top:1px solid #d9c69e !important; padding:.4em .5em !important;}\n[data-design-mode=\"free\"] .art-card .badge{background:#b3423a !important; color:#fdf6e3 !important; border-radius:0 3px 3px 0 !important; padding:.15em .6em !important; font-size:.7em !important; letter-spacing:.1em !important; box-shadow:2px 0 3px rgba(0,0,0,.15) !important;}\n[data-design-mode=\"free\"] .star-ic{color:#d08a1e !important; filter:drop-shadow(0 1px 0 rgba(255,255,255,.6)) !important;}\n[data-design-mode=\"free\"] .thumb-price{background:#3e2f2a !important; color:#ffe8a3 !important; border-radius:2px !important; font-weight:bold !important; font-family:\"Hiragino Mincho ProN\",serif !important; padding:.2em .6em !important; box-shadow:inset 0 0 4px rgba(255,255,255,.2) !important;}\n[data-design-mode=\"free\"] .thumb-unpaid{background:#a33b32 !important; color:#fff !important; border-radius:2px !important; font-family:sans-serif !important;}\n\n/* 选中态 ✓ 和风五角? 用边框+内阴影 */\n[data-design-mode=\"free\"] .art-card.selected{border-color:#b3423a !important; box-shadow:0 0 0 3px rgba(179,66,58,.25), 0 4px 12px rgba(179,66,58,.2) !important; background:linear-gradient(135deg, #fdf8ec 0%, #fbefd9 100%) !important;}\n[data-design-mode=\"free\"] .art-card.selected::after{content:\"朱\" !important; position:absolute !important; top:-2px !important; right:8px !important; background:#b3423a !important; color:#fdf6e3 !important; font-size:.7em !important; font-weight:normal !important; padding:.1em .5em !important; border-radius:0 0 4px 4px !important; box-shadow:0 2px 4px rgba(0,0,0,.2) !important; letter-spacing:.15em !important; line-height:1.4 !important; z-index:4 !important; animation:sealShake .3s !important;}\n@keyframes sealShake{0%{transform: scale(1.4) rotate(-8deg) !important; opacity: .5}\n  60%{transform:scale(.95) rotate(4deg)}\n  100%{transform:scale(1) rotate(0)} !important;}\n\n/* 网格背景 · 古纸 */\n[data-design-mode=\"free\"] .gallery-grid{background:transparent !important; grid-gap:14px !important;}\n[data-design-mode=\"free\"] .content-header{border-bottom:1px dashed #b8a47c !important; background:rgba(253,248,236,.6) !important; padding:1em 1.2em !important;}\n\n/* 按钮 · 和风角丸 */\n[data-design-mode=\"free\"] .btn{background:#fdf6e3 !important; color:#3e2f2a !important; border:2px solid #b3423a !important; border-radius:0 !important; font-family:\"Hiragino Mincho ProN\",\"Yu Mincho\",serif !important; letter-spacing:.1em !important; padding:.45em 1.1em !important; box-shadow:2px 2px 0 #8a6b3c !important; transition:all .15s !important; text-transform:none !important;}\n[data-design-mode=\"free\"] .btn:hover{background:#b3423a !important; color:#fdf6e3 !important; transform:translate(1px,1px) !important; box-shadow:1px 1px 0 #8a6b3c !important;}\n[data-design-mode=\"free\"] .btn.primary{background:#b3423a !important; color:#fdf6e3 !important; box-shadow:2px 2px 0 #5d1c18 !important; border-color:#5d1c18 !important;}\n[data-design-mode=\"free\"] .btn.primary:hover{background:#d65a50 !important; box-shadow:1px 1px 0 #5d1c18 !important;}\n[data-design-mode=\"free\"] .btn:active{transform:translate(2px,2px) !important; box-shadow:0 0 0 #5d1c18 !important;}\n\n/* 弹窗 & 编辑面板 */\n[data-design-mode=\"free\"] .modal,\n[data-design-mode=\"free\"] .edit-panel{background:#f5ecd8 !important; border:8px double #b3423a !important; border-radius:4px !important; box-shadow:0 10px 30px rgba(50,30,10,.4) !important;}\n[data-design-mode=\"free\"] .modal::before,\n[data-design-mode=\"free\"] .edit-panel::before{content:\"\" !important; position:absolute !important; top:0 !important; left:0 !important; right:0 !important; bottom:0 !important; pointer-events:none !important; background:repeating-linear-gradient(0deg, rgba(120,90,40,.04) 0px, rgba(120,90,40,.04) 1px, transparent 1px, transparent 3px) !important; border-radius:inherit !important;}\n[data-design-mode=\"free\"] .modal .modal-header,\n[data-design-mode=\"free\"] .edit-panel h3{background:#b3423a !important; color:#fdf6e3 !important; border-bottom:2px solid #5d1c18 !important; font-family:\"Hiragino Mincho ProN\",serif !important; letter-spacing:.2em !important; padding:.6em 1em !important; margin:-1px !important;}\n\n/* 表单 */\n[data-design-mode=\"free\"] input,\n[data-design-mode=\"free\"] select,\n[data-design-mode=\"free\"] textarea{background:#fff9ec !important; border:1px solid #c9b48a !important; border-radius:2px !important; color:#3e2f2a !important; font-family:\"Hiragino Sans\",\"Noto Sans JP\",sans-serif !important;}\n[data-design-mode=\"free\"] input:focus,\n[data-design-mode=\"free\"] select:focus,\n[data-design-mode=\"free\"] textarea:focus{border-color:#b3423a !important; box-shadow:0 0 0 2px rgba(179,66,58,.15) !important;}\n\n/* 总计条 */\n[data-design-mode=\"free\"] .total-price-bar{background:#efe3c8 !important; border-top:3px solid #b3423a !important; box-shadow:0 -2px 8px rgba(120,90,40,.15) !important; font-family:\"Hiragino Mincho ProN\",serif !important;}\n\n/* 筛选 / 工具栏 */\n[data-design-mode=\"free\"] .filter-trigger,\n[data-design-mode=\"free\"] .view-toolbar{background:#efe3c8 !important; border:1px solid #c9b48a !important; border-radius:0 !important; color:#3e2f2a !important;}\n\n/* 日历卡 & 辅助卡 */\n[data-design-mode=\"free\"] .cal-day-card{background:#fdf8ec !important; border:1px solid #c9b48a !important; border-radius:4px !important; box-shadow:2px 2px 0 rgba(120,90,40,.1) !important;}\n[data-design-mode=\"free\"] .cal-day-card.today{border:2px solid #b3423a !important;}\n\n[data-design-mode=\"free\"] .oc-card,\n[data-design-mode=\"free\"] .wv-card{background:#fdf8ec !important; border:1px solid #c9b48a !important; border-radius:4px !important; box-shadow:2px 3px 0 rgba(120,90,40,.12) !important;}\n\n/* 滚动条古风 */\n[data-design-mode=\"free\"] ::-webkit-scrollbar{width:12px !important;}\n[data-design-mode=\"free\"] ::-webkit-scrollbar-track{background:#e8d9bc !important;}\n[data-design-mode=\"free\"] ::-webkit-scrollbar-thumb{background:#b3423a !important; border-radius:6px !important; border:2px solid #e8d9bc !important;}\n\n/* 链接图标 / 通用 */\n[data-design-mode=\"free\"] a{color:#a63b33 !important;}\n[data-design-mode=\"free\"] .thumb-overlay .thumb-title,\n[data-design-mode=\"free\"] .card-tags .badge{letter-spacing:.05em !important;}\n\n/* ===== 自定义卡片 ===== */\n[data-design-mode=\"free\"] .my-retro-card{position:relative !important; background:linear-gradient(135deg, #fdf8ec 0%, #f2e4c9 100%) !important; border:1px solid #b8a47c !important; border-radius:4px !important; box-shadow:0 2px 6px rgba(100,70,30,.12) !important; padding:12px 12px 14px !important; transition:box-shadow .2s !important;}\n[data-design-mode=\"free\"] .my-retro-card:hover{box-shadow:0 4px 16px rgba(120,80,30,.22), 2px 2px 0 rgba(179,66,58,.3) !important;}\n\n/* 封面框 */\n[data-design-mode=\"free\"] .my-retro-cover{position:relative !important; border:2px solid #d6b98c !important; border-radius:2px !important; background:#e8d9bc !important; margin-bottom:8px !important; overflow:hidden !important;}\n[data-design-mode=\"free\"] .my-retro-cover::after{content:\"\" !important; position:absolute !important; top:0 !important; left:0 !important; width:100% !important; height:100% !important; background:repeating-linear-gradient(45deg, rgba(180,150,100,.06) 0 4px, transparent 4px 12px) !important; pointer-events:none !important;}\n[data-design-mode=\"free\"] .my-retro-cover img{display:block !important; width:100% !important; max-height:160px !important; object-fit:cover !important; filter:sepia(.2) contrast(.92) !important;}\n\n/* 印章区块 */\n[data-design-mode=\"free\"] .my-retro-seal{position:absolute !important; top:8px !important; right:8px !important; background:#ba3b30 !important; color:#fdf6e3 !important; font-family:\"Hiragino Mincho ProN\",serif !important; font-size:10px !important; padding:4px 7px !important; border-radius:2px !important; box-shadow:0 0 0 1px #8a1e15 inset, 0 0 8px rgba(180,50,40,.4) !important; letter-spacing:.1em !important; transform:rotate(4deg) !important; line-height:1 !important; z-index:2 !important;}\n/* 呼出型价格和未付 */\n[data-design-mode=\"free\"] .my-retro-price{display:inline-block !important; background:#3e2f2a !important; color:#ffe8a3 !important; font-family:\"Hiragino Mincho ProN\",serif !important; font-size:12px !important; padding:3px 8px !important; border-radius: 2px !important; box-shadow:2px 2px 0 rgba(120,80,30,.15) !important; margin-top:4px !important;}\n[data-design-mode=\"free\"] .my-retro-unpaid{background:#ba3b30 !important; color:#fff !important; font-family:\"Hiragino Mincho ProN\",serif !important; font-size:11px !important; padding:2px 6px !important; margin-left:4px !important; border-radius:2px !important;}\n\n/* 标题/作者 */\n[data-design-mode=\"free\"] .my-retro-title{font-family:\"Hiragino Mincho ProN\",\"Yu Mincho\",serif !important; font-size:15px !important; color:#3e2f2a !important; letter-spacing:.06em !important; margin:4px 0 2px !important; line-height:1.4 !important; border-left:3px solid #ba3b30 !important; padding-left:8px !important; overflow:hidden !important; text-overflow:ellipsis !important; white-space:nowrap !important;}\n[data-design-mode=\"free\"] .my-retro-author{font-size:11px !important; color:#6b5a48 !important; margin:2px 0 4px !important; font-family:\"Hiragino Sans\",\"Noto Sans JP\",sans-serif !important;}\n\n/* 标签区 */\n[data-design-mode=\"free\"] .my-retro-tags{display:flex !important; flex-wrap:wrap !important; gap:4px !important; margin-top:6px !important;}\n[data-design-mode=\"free\"] .my-retro-tags .my-tag{background:#e8dcc2 !important; color:#4a3b30 !important; font-size:10px !important; padding:2px 7px !important; border:1px solid #b8a47c !important; border-radius:10px !important; font-family:\"Hiragino Sans\",sans-serif !important; letter-spacing:.03em !important;}\n\n/* 底部工具条 */\n[data-design-mode=\"free\"] .my-retro-footer{display:flex !important; justify-content:space-between !important; align-items:center !important; margin-top:8px !important; padding-top:6px !important; border-top:1px dashed #c9b48a !important;}\n[data-design-mode=\"free\"] .my-retro-rate{color:#c77b16 !important; font-size:11px !important; font-family:\"Hiragino Sans\",sans-serif !important;}\n[data-design-mode=\"free\"] .my-retro-rate::before{content:\"★\" !important; color:#d08a1e !important; margin-right:2px !important;}\n\n/* 选择框和编辑按钮改和风 */\n[data-design-mode=\"free\"] .my-retro-card input[type=\"checkbox\"]{appearance:none !important; width:16px !important; height:16px !important; border:1px solid #8a6b3c !important; border-radius:0 !important; background:#fdf8ec !important; cursor:pointer !important; display:inline-block !important; vertical-align:middle !important; position:relative !important;}\n[data-design-mode=\"free\"] .my-retro-card input[type=\"checkbox\"]:checked{background:#ba3b30 !important; border-color:#5d1c18 !important;}\n[data-design-mode=\"free\"] .my-retro-card input[type=\"checkbox\"]:checked::after{content:\"〆\" !important; position:absolute !important; top:50% !important; left:50% !important; transform:translate(-50%,-50%) !important; color:#fff !important; font-size:11px !important; line-height:1 !important; font-weight:bold !important;}\n[data-design-mode=\"free\"] .my-retro-card .btn{font-size:10px !important; padding:2px 8px !important; box-shadow:1px 1px 0 #8a6b3c !important; border-width:1px !important;}\n[data-design-mode=\"free\"] .my-retro-card .btn:hover{transform:translate(1px,1px) !important; box-shadow:0 0 0 #8a6b3c !important;}\n\n/* ===== [古日·修复 灰度模式/模糊封面] ===== */\n/* 主题在 .thumb img / .my-retro-cover img 上设了 sepia filter(!important)，\n   可能盖掉 app 的灰度/模糊；用更高优先级把灰度/模糊重新落到容器与图片上。 */\n[data-ai-theme] .thumb.grayscaled,\n[data-design-mode=\"free\"] .thumb.grayscaled{filter:grayscale(1)!important;}\n[data-ai-theme] .thumb.blurred,\n[data-design-mode=\"free\"] .thumb.blurred{filter:blur(9px)!important;}\n[data-ai-theme] .art-card .thumb.grayscaled img,\n[data-design-mode=\"free\"] .art-card .thumb.grayscaled img{filter:grayscale(1)!important;}\n[data-ai-theme] .my-retro-cover .thumb.grayscaled img,\n[data-design-mode=\"free\"] .my-retro-cover .thumb.grayscaled img{filter:grayscale(1)!important;}\n[data-ai-theme] .art-card:hover .thumb.blurred img,\n[data-design-mode=\"free\"] .art-card:hover .thumb.blurred img{filter:sepia(0)!important;}\n\n/* ===== [古日·瀑布流修正] ===== */\n/* 瀑布流：解除 app 的 grid 锁定，恢复列式错落；封面按图片原始高度 */\n[data-ai-theme] .gallery-grid.view-masonry,\n[data-design-mode=\"free\"] .gallery-grid.view-masonry{display:block!important; column-gap:16px!important;}\n[data-ai-theme] .gallery-grid.view-masonry .art-card,\n[data-design-mode=\"free\"] .gallery-grid.view-masonry .art-card{display:inline-block!important; width:100%!important; margin-bottom:18px!important; break-inside:avoid!important; aspect-ratio:auto!important; height:auto!important;}\n[data-ai-theme] .gallery-grid.view-masonry .my-retro-card,\n[data-design-mode=\"free\"] .gallery-grid.view-masonry .my-retro-card{width:100%!important;}\n[data-ai-theme] .gallery-grid.view-masonry .my-retro-cover img,\n[data-design-mode=\"free\"] .gallery-grid.view-masonry .my-retro-cover img{max-height:none!important; height:auto!important; aspect-ratio:auto!important; object-fit:cover!important;}\n\n/* ===== [古日·精简模式只显图] ===== */\n/* 精简模式：只显示图片，隐藏全部文字信息与装饰印章 */\n[data-ai-theme] body.compact-mode .my-retro-info,\n[data-design-mode=\"free\"] body.compact-mode .my-retro-info{display:none!important;}\n[data-ai-theme] body.compact-mode .my-retro-seal,\n[data-design-mode=\"free\"] body.compact-mode .my-retro-seal{display:none!important;}\n[data-ai-theme] body.compact-mode .art-card::before,\n[data-design-mode=\"free\"] body.compact-mode .art-card::before{display:none!important;}\n[data-ai-theme] body.compact-mode .my-retro-card,\n[data-design-mode=\"free\"] body.compact-mode .my-retro-card{padding:0!important; border:none!important; background:transparent!important; box-shadow:none!important; min-height:0!important;}\n[data-ai-theme] body.compact-mode .my-retro-cover,\n[data-design-mode=\"free\"] body.compact-mode .my-retro-cover{margin:0!important; border:none!important; border-radius:0!important; overflow:hidden!important;}\n/* 网格视图 + 精简模式：图片铺满统一正方形（app 全局 aspect-ratio:1/1） */\n[data-ai-theme] body.compact-mode .gallery-grid:not(.view-masonry) .my-retro-card,\n[data-design-mode=\"free\"] body.compact-mode .gallery-grid:not(.view-masonry) .my-retro-card{width:100%!important; height:100%!important;}\n[data-ai-theme] body.compact-mode .gallery-grid:not(.view-masonry) .my-retro-cover,\n[data-design-mode=\"free\"] body.compact-mode .gallery-grid:not(.view-masonry) .my-retro-cover{width:100%!important; height:100%!important;}\n[data-ai-theme] body.compact-mode .gallery-grid:not(.view-masonry) .my-retro-cover .thumb,\n[data-design-mode=\"free\"] body.compact-mode .gallery-grid:not(.view-masonry) .my-retro-cover .thumb{width:100%!important; height:100%!important; aspect-ratio:auto!important; object-fit:cover!important; display:block!important;}\n/* 瀑布流 + 精简模式：图片按原始高度自适应 */\n[data-ai-theme] body.compact-mode .gallery-grid.view-masonry .my-retro-cover img,\n[data-design-mode=\"free\"] body.compact-mode .gallery-grid.view-masonry .my-retro-cover img{max-height:none!important; height:auto!important; aspect-ratio:auto!important; object-fit:cover!important;}\n/* ===== [古日·网格去空白] ===== */\n/* 网格视图(非精简)：卡片高度只由自身内容决定，解除 CSS Grid 行拉伸，\n   较短卡片不再被拉高，底部不再留白框。精简模式仍走下方正方形规则。 */\n[data-ai-theme] body:not(.compact-mode) .gallery-grid:not(.view-masonry) .art-card,\n[data-design-mode=\"free\"] body:not(.compact-mode) .gallery-grid:not(.view-masonry) .art-card{aspect-ratio:auto!important; height:fit-content!important; align-self:start!important;}\n[data-ai-theme] body:not(.compact-mode) .gallery-grid:not(.view-masonry) .my-retro-card,\n[data-design-mode=\"free\"] body:not(.compact-mode) .gallery-grid:not(.view-masonry) .my-retro-card{height:fit-content!important;}\n\n\n/* ===== [古日·渠道印章 + 右下角数量悬浮] ===== */\n/* 1) 渠道印章：显示该稿件「渠道选项框」里的内容（app 暴露 {{channel};}）；\n   没有渠道时整枚印章隐藏。 */\n[data-ai-theme] .my-retro-seal:has(.my-retro-channel:empty),\n[data-design-mode=\"free\"] .my-retro-seal:has(.my-retro-channel:empty){display:none!important;}\n/* 2) 图片右下角：图片数 / 附件数，仅鼠标划过封面时显示，无 emoji */\n[data-ai-theme] .my-retro-counts,\n[data-design-mode=\"free\"] .my-retro-counts{position:absolute!important; right:6px!important; bottom:6px!important; background:rgba(40,30,20,.62)!important; color:#fdf6e3!important; font-size:10px!important; font-family:\"Hiragino Sans\",\"Noto Sans JP\",sans-serif!important; padding:2px 7px!important; border-radius:3px!important; line-height:1.4!important; letter-spacing:.02em!important; opacity:0!important; transform:translateY(3px)!important; transition:opacity .15s ease, transform .15s ease!important; pointer-events:none!important; z-index:5!important;}\n[data-ai-theme] .my-retro-cover:hover .my-retro-counts,\n[data-design-mode=\"free\"] .my-retro-cover:hover .my-retro-counts{opacity:1!important; transform:translateY(0)!important;}\n\n/* ===== [古日·精简网格正方形·去框遮挡] ===== */\n/* 网格+精简：去掉 1px 卡片边框 / 2px 封面底边 / 160px 图高上限 / 斜纹遮罩，\n   让图片铺满统一正方形，不被任何“框”遮挡。 */\n[data-ai-theme] body.compact-mode .gallery-grid:not(.view-masonry) .art-card,\n[data-design-mode=\"free\"] body.compact-mode .gallery-grid:not(.view-masonry) .art-card{border:none!important; background:transparent!important; box-shadow:none!important;}\n[data-ai-theme] body.compact-mode .gallery-grid:not(.view-masonry) .my-retro-cover::after,\n[data-design-mode=\"free\"] body.compact-mode .gallery-grid:not(.view-masonry) .my-retro-cover::after{display:none!important;}\n[data-ai-theme] body.compact-mode .gallery-grid:not(.view-masonry) .my-retro-cover .thumb,\n[data-design-mode=\"free\"] body.compact-mode .gallery-grid:not(.view-masonry) .my-retro-cover .thumb{border:none!important; border-bottom:none!important; max-height:none!important;}\n\n/* ===== [古日·卡片悬浮编辑按钮] ===== */\n/* 编辑按钮锚定在 .my-retro-card（整张卡片）上，而非封面，故落在卡片真实右下角；\n   精简模式卡片=封面，二者重合，效果不变。悬停整张卡片即出现。\n   复用 app 的 .cover-edit-btn（已在 [v52] 改为 querySelectorAll 全量绑定），点击直接进入编辑表单。 */\n[data-ai-theme] .my-retro-edit-btn,\n[data-design-mode=\"free\"] .my-retro-edit-btn{position:absolute!important; right:8px!important; bottom:8px!important; z-index:6!important; width:30px!important; height:30px!important; border-radius:50%!important; border:1px solid rgba(253,246,227,.55)!important; background:rgba(40,28,20,.78)!important; color:#fdf6e3!important; font-size:15px!important; line-height:28px!important; text-align:center!important; cursor:pointer!important; padding:0!important; opacity:0!important; transform:translateY(4px) scale(.92)!important; transition:opacity .15s ease, transform .15s ease!important; box-shadow:0 2px 6px rgba(0,0,0,.42)!important;}\n[data-ai-theme] .my-retro-card:hover .my-retro-edit-btn,\n[data-design-mode=\"free\"] .my-retro-card:hover .my-retro-edit-btn{opacity:1!important; transform:translateY(0) scale(1)!important;}\n[data-ai-theme] .my-retro-edit-btn:hover,\n[data-design-mode=\"free\"] .my-retro-edit-btn:hover{background:#b3423a!important; color:#fdf6e3!important;}\n/* 精简模式：卡片=封面，右下角编辑按钮与数量标签重叠，数量标签左移避开 */\n[data-ai-theme] body.compact-mode .my-retro-counts,\n[data-design-mode=\"free\"] body.compact-mode .my-retro-counts{right:42px!important;}\n/* 非精简：卡片右下角编辑按钮压在底部工具条右侧，footer 留出右侧空间给选择框 */\n[data-ai-theme] body:not(.compact-mode) .my-retro-footer,\n[data-design-mode=\"free\"] body:not(.compact-mode) .my-retro-footer{padding-right:40px!important;}\n\n/* ===== [古日·精简模式 选择框 hover/已选 才出现] ===== */\n/* 精简模式默认把 .my-retro-info 整体隐藏，选择框也被藏掉。改为只隐藏文字，\n   选择框(.sel-check)作左上角浮层：默认隐藏，划过卡片 或 卡片已选中 时才显示（等同普通模式）。 */\n[data-ai-theme] body.compact-mode .my-retro-info,\n[data-design-mode=\"free\"] body.compact-mode .my-retro-info{display:block !important; position:absolute !important; top:0 !important; left:0 !important; pointer-events:none !important; z-index:5 !important;}\n[data-ai-theme] body.compact-mode .my-retro-info > *:not(.my-retro-footer),\n[data-design-mode=\"free\"] body.compact-mode .my-retro-info > *:not(.my-retro-footer),\n[data-ai-theme] body.compact-mode .my-retro-footer > .my-retro-rate,\n[data-design-mode=\"free\"] body.compact-mode .my-retro-footer > .my-retro-rate{display:none !important;}\n[data-ai-theme] body.compact-mode .my-retro-footer,\n[data-design-mode=\"free\"] body.compact-mode .my-retro-footer{display:block !important; pointer-events:none !important;}\n[data-ai-theme] body.compact-mode .my-retro-actions,\n[data-design-mode=\"free\"] body.compact-mode .my-retro-actions{display:block !important; pointer-events:auto !important;}\n[data-ai-theme] body.compact-mode .sel-check,\n[data-design-mode=\"free\"] body.compact-mode .sel-check{position:absolute !important; top:8px !important; left:8px !important; display:none !important;}\n[data-ai-theme] body.compact-mode .art-card:hover .sel-check,\n[data-design-mode=\"free\"] body.compact-mode .art-card:hover .sel-check,\n[data-ai-theme] body.compact-mode .art-card.selected .sel-check,\n[data-design-mode=\"free\"] body.compact-mode .art-card.selected .sel-check{display:block !important;}\n\n/* ===== [古日·精简模式 已选描边环] ===== */\n/* 精简模式选择框默认隐藏，已选卡片仅靠「朱」角标辨识不够直观；加一道主题色细描边环，\n   不划过也能一眼看出哪些已选。仅作用于精简模式。 */\n[data-ai-theme] body.compact-mode .art-card.selected,\n[data-design-mode=\"free\"] body.compact-mode .art-card.selected{outline:2px solid #b3423a !important; outline-offset:-2px !important;}",
    "customHtml": "<template data-slot=\"card\">\n  <div class=\"my-retro-card\">\n    <div class=\"my-retro-cover\">\n      {{cover}}\n      <span class=\"my-retro-counts\">图 {{imgN}} · 附件 {{fileN}}</span>\n      <span class=\"my-retro-seal\">♢<span class=\"my-retro-channel\">{{channel}}</span></span>\n    </div>\n    <div class=\"my-retro-info\">\n      <h3 class=\"my-retro-title\">{{title}}</h3>\n      <p class=\"my-retro-author\">{{author}} · {{type}}</p>\n      <div class=\"my-retro-price-row\">\n        <span class=\"my-retro-price\">{{price}}</span>\n        <span class=\"my-retro-unpaid\">{{unpaid}}</span>\n      </div>\n      <div class=\"my-retro-tags\">{{tags}}</div>\n      <div class=\"my-retro-footer\">\n        <span class=\"my-retro-rate\">{{rating}}</span>\n        <div class=\"my-retro-actions\">\n          {{selBox}}\n        </div>\n      </div>\n    </div>\n    <button type=\"button\" class=\"my-retro-edit-btn cover-edit-btn\" data-id=\"{{id}}\" title=\"编辑\">✎</button>\n  </div>\n</template>",
    "spacing": {
      "base": 8,
      "scale": 1
    },
    "font": {
      "family": "system"
    },
    "layoutMap": {},
    "iconMode": "emoji",
    "iconFontUrl": "",
    "customIcons": {}
  },
  "exportedAt": "2026-08-11T03:24:35.755Z"
}