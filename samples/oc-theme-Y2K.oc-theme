    "customCss": "[data-ai-theme]{--y2k-bg: #ffd1dc !important; --y2k-text: #3b0a3e !important; --y2k-surface: #fff8a6 !important; --y2k-accent: #ff00c1 !important; --y2k-accent2: #6a5acd !important; --y2k-border: #7a0a82 !important;}\n[data-ai-theme] body{background: \n    repeating-linear-gradient(0deg, rgba(255,255,255,0.3) 0px, rgba(255,255,255,0.3) 2px, transparent 2px, transparent 8px),\n    repeating-linear-gradient(90deg, rgba(255,0,193,0.12) 0px, rgba(255,0,193,0.12) 1px, transparent 1px, transparent 6px),\n    radial-gradient(circle at 15% 20%, #fff7d6 0%, #ffd1dc 45%, #cdf0ff 100%) !important; color: var(--y2k-text) !important; font-family: \"Comic Sans MS\", \"Chalkboard SE\", \"Marker Felt\", sans-serif !important; cursor: url('data:image/svg+xml;utf8,<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 16 16\"><path fill=\"%23ff00c1\" d=\"M0 0 L16 8 L0 16 Z\"/><path fill=\"%23fff\" d=\"M4 4 L10 8 L4 12 Z\"/></svg>') 7 7, auto !important;}\n[data-ai-theme] .art-card{background: linear-gradient(145deg, #fffbe8 0%, #fff4b8 50%, #ffd9f2 100%) !important; border: 3px solid var(--y2k-border) !important; border-radius: 18px !important; box-shadow: 5px 5px 0 #ff00c1, 8px 8px 0 #6a5acd !important; padding: 12px !important; position: relative !important; transition: all 0.2s ease !important; overflow: hidden !important;}\n[data-ai-theme] .art-card::before{content: \"✦\" !important; position: absolute !important; top: -5px !important; right: -2px !important; font-size: 26px !important; color: #ff00c1 !important; transform: rotate(15deg) !important; text-shadow: 1px 1px 0 #fff, -1px -1px 0 #9b59b6 !important; z-index: 2 !important;}\n[data-ai-theme] .art-card::after{content: \"★\" !important; position: absolute !important; bottom: 4px !important; left: 4px !important; font-size: 14px !important; color: #ff00c1 !important; opacity: 0.6 !important; text-shadow: 0 0 3px yellow !important;}\n[data-ai-theme] .art-card:hover{transform: translate(-2px, -2px) rotate(-0.5deg) scale(1.01) !important; box-shadow: 8px 8px 0 #6a5acd, 12px 12px 0 #ff00c1 !important; border-color: #ff00c1 !important;}\n[data-ai-theme] .thumb{border-radius: 12px !important; border: 2px solid #ff00c1 !important; outline: 2px dotted #ffff00 !important; outline-offset: 2px !important; filter: saturate(1.4) contrast(1.1) !important;}\n[data-ai-theme] .thumb-overlay{background: linear-gradient(0deg, rgba(255,0,193,0.4) 0%, transparent 60%) !important; border-radius: 12px !important;}\n[data-ai-theme] .thumb-title{font-family: \"Comic Sans MS\", \"Chalkboard SE\", sans-serif !important; color: #fff !important; text-shadow: 2px 2px 0 #ff00c1, -1px -1px 0 #6a5acd !important; font-weight: bold !important; letter-spacing: 0.5px !important;}\n[data-ai-theme] .sidebar{background: linear-gradient(180deg, #ffd1dc, #fff4b8, #cdf0ff) !important; border-right: 4px solid #ff00c1 !important; border-bottom: 4px solid #6a5acd !important; box-shadow: 4px 0 0 #ffff00 !important;}\n[data-ai-theme] .side-head{background: transparent !important; border-bottom: 3px dashed #ff00c1 !important;}\n[data-ai-theme] .side-head .logo,\n[data-ai-theme] .side-head span,\n[data-ai-theme] .side-head a{color: var(--y2k-accent) !important; text-shadow: 2px 2px 0 #ffff00 !important; font-weight: 900 !important;}\n[data-ai-theme] .topbar{background: linear-gradient(90deg, #ff00c1, #ff7eb3, #ffff66, #6a5acd) !important; border-bottom: 3px solid #fff !important; box-shadow: 0 4px 0 #ff00c1 !important;}\n[data-ai-theme] .topbar *{color: #fff !important; text-shadow: 2px 2px 0 #ff00c1 !important; font-weight: bold !important;}\n[data-ai-theme] .gallery-grid{background-image: \n    radial-gradient(circle, #ff00c1 1px, transparent 1px),\n    radial-gradient(circle, #6a5acd 1px, transparent 1px) !important; background-size: 24px 24px, 32px 32px !important; background-position: 0 0, 12px 12px !important; padding: 16px !important; gap: 20px !important;}\n[data-ai-theme] .content-header{background: rgba(255,255,255,0.7) !important; border: 3px ridge #ff00c1 !important; border-radius: 16px !important; box-shadow: inset 0 0 15px #ffff00 !important;}\n[data-ai-theme] .content-header *{color: var(--y2k-text) !important;}\n[data-ai-theme] .card-tags{margin-top: 8px !important; padding: 2px !important;}\n[data-ai-theme] .badge{background: linear-gradient(135deg, #6a5acd, #ff00c1) !important; color: #fff !important; border: 1px solid #fff !important; border-radius: 20px !important; box-shadow: 0 0 0 1px #ff00c1, 0 2px 4px rgba(59,10,62,0.4) !important; font-family: \"Comic Sans MS\", sans-serif !important; font-size: 11px !important; padding: 2px 10px !important; text-transform: uppercase !important; letter-spacing: 1px !important;}\n[data-ai-theme] .badge::before{content: \"✦ \" !important;}\n[data-ai-theme] .btn{background: linear-gradient(180deg, #fff 0%, #ffb3d9 50%, #ff66b2 100%) !important; color: #3b0a3e !important; border: 2px solid #ff00c1 !important; border-radius: 15px !important; box-shadow: 3px 3px 0 #6a5acd, inset 1px 1px 0 #fff, inset -1px -1px 0 #ff66b2 !important; font-family: \"Comic Sans MS\", sans-serif !important; font-weight: bold !important; padding: 4px 14px !important; text-transform: none !important; cursor: pointer !important; transition: all 0.1s ease !important;}\n[data-ai-theme] .btn:hover{transform: translate(-1px, -1px) !important; box-shadow: 4px 4px 0 #ff00c1, inset 1px 1px 0 #fff !important; background: linear-gradient(180deg, #ffe66e, #ffb3d9) !important;}\n[data-ai-theme] .btn:active{transform: translate(3px, 3px) !important; box-shadow: 0 0 0 #ff00c1, inset 2px 2px 4px rgba(0,0,0,0.2) !important;}\n[data-ai-theme] .btn.primary{background: linear-gradient(180deg, #ffff66, #ff00c1) !important; color: #fff !important; border-color: #6a5acd !important; text-shadow: 1px 1px 0 #ff00c1 !important; box-shadow: 4px 4px 0 #3b0a3e !important;}\n[data-ai-theme] .btn.primary:hover{background: linear-gradient(180deg, #ff00c1, #ffff66) !important; box-shadow: 5px 5px 0 #3b0a3e !important;}\n[data-ai-theme] .modal{background: linear-gradient(135deg, #fff6d5, #ffe0f0, #e0f7ff) !important; border: 4px ridge #ff00c1 !important; border-radius: 24px !important; box-shadow: 8px 8px 0 #6a5acd, 12px 12px 0 #ffff00 !important;}\n[data-ai-theme] .modal::before{content: \"✧  ♫  ✧\" !important; display: block !important; text-align: center !important; font-size: 20px !important; color: #ff00c1 !important; padding-bottom: 4px !important;}\n[data-ai-theme] .edit-panel{background: linear-gradient(145deg, #fffbe8, #ffe6f5) !important; border: 2px solid #ff00c1 !important; border-radius: 16px !important; box-shadow: inset 0 0 0 2px #ffff00 !important;}\n[data-ai-theme] .total-price-bar{background: linear-gradient(90deg, #ff00c1, #6a5acd) !important; border: 2px solid #fff !important; border-radius: 20px !important; box-shadow: 0 0 0 2px #ff00c1, 4px 4px 0 #3b0a3e !important; color: #fff !important; font-weight: 900 !important; padding: 10px 20px !important;}\n[data-ai-theme] .total-price-bar span,\n[data-ai-theme] .total-price-bar *{color: #fff !important; text-shadow: 1px 1px 0 #ff00c1 !important;}\n[data-ai-theme] .filter-trigger,\n[data-ai-theme] .view-toolbar{background: rgba(255,255,255,0.8) !important; border: 2px solid #ff00c1 !important; border-radius: 20px !important; box-shadow: 0 0 0 1px #6a5acd !important;}\n[data-ai-theme] .filter-trigger:hover,\n[data-ai-theme] .view-toolbar:hover{box-shadow: 0 0 10px #ff00c1 !important;}\n[data-ai-theme] .star-ic{color: #ffcc00 !important; text-shadow: 1px 1px 0 #ff00c1 !important; font-size: 1.2em !important;}\n[data-ai-theme] .thumb-rating{color: #3b0a3e !important; background: #ffff66 !important; border-radius: 10px !important; padding: 0 4px !important; font-weight: bold !important;}\n[data-ai-theme] .thumb-price{color: #ff00c1 !important; font-weight: 900 !important; background: #fff !important; border: 1px solid #ff00c1 !important; padding: 0 6px !important; border-radius: 10px !important;}\n[data-ai-theme] .thumb-unpaid{background: #ff00c1 !important; color: #fff !important; border-radius: 10px !important; padding: 0 6px !important; font-weight: bold !important; box-shadow: 0 0 4px #ff00c1 !important;}\n[data-ai-theme] .cal-day-card{background: #fffbe8 !important; border: 2px solid #ff00c1 !important; border-radius: 12px !important; box-shadow: 3px 3px 0 #6a5acd !important;}\n[data-ai-theme] .oc-card,\n[data-ai-theme] .wv-card{background: linear-gradient(145deg, #fff9c9, #ffe2f0) !important; border: 3px solid #6a5acd !important; border-radius: 18px !important; box-shadow: 4px 4px 0 #ff00c1 !important;}\n[data-ai-theme] .oc-card:hover,\n[data-ai-theme] .wv-card:hover{box-shadow: 6px 6px 0 #ff00c1 !important;}\n[data-ai-theme] input, [data-ai-theme] select, [data-ai-theme] textarea{background: #fff !important; border: 2px solid #ff00c1 !important; border-radius: 10px !important; color: #3b0a3e !important; box-shadow: 2px 2px 0 #ffff00 !important; font-family: \"Comic Sans MS\", sans-serif !important;}\n[data-ai-theme] input:focus, [data-ai-theme] select:focus, [data-ai-theme] textarea:focus{box-shadow: 0 0 10px #ff00c1, 2px 2px 0 #6a5acd !important; outline: none !important;}\n[data-ai-theme] ::selection{background: #ff00c1 !important; color: #fff !important;}\n[data-ai-theme] .gallery-grid .art-card:nth-child(3n+1){transform: rotate(-0.5deg) !important;}\n[data-ai-theme] .gallery-grid .art-card:nth-child(3n+2){transform: rotate(0.5deg) !important;}\n[data-ai-theme] .gallery-grid .art-card:nth-child(5n+3){transform: rotate(-1deg) !important;}\n[data-ai-theme] .gallery-grid .art-card:hover{transform: rotate(0deg) translateY(-4px) !important;}\n[data-ai-theme] .card-tags .badge:nth-child(odd){transform: rotate(-1deg) !important;}\n[data-ai-theme] .card-tags .badge:nth-child(even){transform: rotate(1deg) !important;}\n[data-ai-theme] a{color: #ff00c1 !important; text-decoration: underline wavy #6a5acd !important;}\n@keyframes y2k-blink {0%,49% { opacity: 1 !important; }\n  50%,100% { opacity: 0 !important; };}\n[data-ai-theme] .art-card .thumb::after{content: \"✦\" !important; position: absolute !important; top: 2px !important; right: 2px !important; color: #ff00c1 !important; font-size: 18px !important; text-shadow: 0 0 5px #fff, 0 0 8px #ff00c1 !important; animation: y2k-blink 1s infinite !important;}\n[data-ai-theme] .thumb{position: relative !important;}\n/* 选中态 */\n[data-ai-theme] .art-card:has(.selBox input:checked),\n[data-ai-theme] .art-card.selected{background: linear-gradient(145deg, #cdf0ff, #ffd1dc) !important; border: 4px solid #6a5acd !important; box-shadow: inset 0 0 0 2px #fff, 5px 5px 0 #ff00c1 !important; outline: 3px dashed #ff00c1 !important; outline-offset: 2px !important;}\n[data-ai-theme] .selBox input[type=checkbox]{appearance: none !important; -webkit-appearance: none !important; width: 20px !important; height: 20px !important; background: #fff !important; border: 2px solid #ff00c1 !important; border-radius: 50% !important; display: inline-block !important; position: relative !important; cursor: pointer !important;}\n[data-ai-theme] .selBox input[type=checkbox]:checked{background: #ff00c1 !important; box-shadow: 0 0 8px #ff00c1 !important;}\n[data-ai-theme] .selBox input[type=checkbox]:checked::after{content: \"★\" !important; position: absolute !important; left: 3px !important; top: -2px !important; font-size: 15px !important; color: #fff !important;}\n/* 滚动条 */\n[data-ai-theme] ::-webkit-scrollbar{width: 14px !important;}\n[data-ai-theme] ::-webkit-scrollbar-track{background: #ffd1dc !important; border: 2px solid #ff00c1 !important;}\n[data-ai-theme] ::-webkit-scrollbar-thumb{background: linear-gradient(180deg, #ffff66, #ff00c1) !important; border: 2px solid #6a5acd !important; border-radius: 8px !important;}\n/* 千禧年闪光效果 */\n@keyframes y2k-shine {0% { left: -150% !important; }\n  100% { left: 150% !important; };}\n[data-ai-theme] .art-card .thumb::before{content: \"\" !important; position: absolute !important; top: 0 !important; left: -150% !important; width: 60% !important; height: 100% !important; background: linear-gradient(105deg, transparent, rgba(255,255,255,0.6), transparent) !important; z-index: 1 !important; animation: y2k-shine 3s infinite !important; pointer-events: none !important;}\n[data-ai-theme] .art-card .thumb{overflow: hidden !important;}\n/* 按钮微光 */\n@keyframes y2k-glow {0%,100% { text-shadow: 0 0 3px #fff !important; }\n  50% { text-shadow: 0 0 10px #ff00c1, 0 0 20px #ffff00 !important; };}\n[data-ai-theme] .btn::after{content: \"\" !important; display: inline-block !important; width: 4px !important; height: 4px !important; background: #ff00c1 !important; border-radius: 50% !important; margin-left: 4px !important; animation: y2k-glow 1.2s infinite !important;}\n/* 卡片模板专属类 */\n[data-ai-theme] .y2k-card{display: flex !important; flex-direction: column !important; height: 100% !important; position: relative !important; background: transparent !important;}\n[data-ai-theme] .y2k-cover{margin-bottom: 8px !important; position: relative !important;}\n[data-ai-theme] .y2k-cover .thumb{width: 100% !important; aspect-ratio: 1 / 1 !important; object-fit: cover !important;}\n[data-ai-theme] .y2k-title{font-size: 1.15em !important; font-weight: 900 !important; color: #3b0a3e !important; background: linear-gradient(135deg, #ffff00, #ff00c1) !important; -webkit-background-clip: text !important; background-clip: text !important; -webkit-text-fill-color: transparent !important; text-shadow: none !important; margin: 2px 0 !important; letter-spacing: 1px !important;}\n[data-ai-theme] .y2k-meta{font-size: 0.9em !important; color: #3b0a3e !important; display: flex !important; flex-wrap: wrap !important; gap: 4px !important; margin: 2px 0 !important;}\n[data-ai-theme] .y2k-meta span{background: #fff !important; border: 1px solid #ff00c1 !important; border-radius: 8px !important; padding: 0 6px !important;}\n[data-ai-theme] .y2k-price{font-size: 1.2em !important; font-weight: 900 !important; color: #ff00c1 !important; text-shadow: 2px 2px 0 #ffff00 !important; margin-top: 4px !important; background: linear-gradient(180deg, #fff, #ffd9f2) !important; border: 2px solid #ff00c1 !important; display: inline-block !important; padding: 0 8px !important; border-radius: 15px !important;}\n[data-ai-theme] .y2k-footer{margin-top: auto !important; display: flex !important; justify-content: space-between !important; align-items: center !important; border-top: 2px dashed #ff00c1 !important; padding-top: 6px !important;}\n[data-ai-theme] .y2k-stars{color: #ffcc00 !important; text-shadow: 1px 1px 0 #ff00c1 !important; font-size: 1.1em !important;}\n[data-ai-theme] .y2k-tags{display: flex !important; flex-wrap: wrap !important; gap: 4px !important;}\n[data-ai-theme] .y2k-editbtn{position: absolute !important; bottom: 4px !important; right: 4px !important; background: rgba(255,255,255,0.8) !important; border-radius: 50% !important; border: 2px solid #6a5acd !important; padding: 2px !important;}\n\n/* ===== [Y2K·修复 灰度模式/模糊封面] =====\n   根因：主题给 .thumb 设了 filter:saturate(1.4) contrast(1.1)!important，\n   覆盖掉 app 的 .thumb.grayscaled{filter:grayscale(1)} 与 .thumb.blurred{filter:blur(9px)}\n   （二者无 !important）。以下用更高特异性+!important 把灰度/模糊夺回，平时仍保留 Y2K 滤镜 */\n[data-ai-theme] .thumb.grayscaled{filter:grayscale(1)!important; transition:filter .2s!important;}\n[data-ai-theme] .thumb.blurred{filter:blur(9px)!important; transition:filter .2s!important;}\n/* 保留 app 的 hover 显色（灰度卡 hover 恢复彩色） */\n[data-ai-theme] .art-card:hover .thumb.grayscaled:hover{filter:grayscale(0)!important;}\n/* 时间轴 / 日历 视图的灰度（app 挂在 .tl-imgs / img / .cal-day-thumb 上）一并保底 */\n[data-ai-theme] .tl-imgs.grayscaled{filter:grayscale(1)!important;}\n[data-ai-theme] .cal-thumbs img.grayscaled{filter:grayscale(1)!important;}\n[data-ai-theme] .cal-day-thumb.grayscaled{filter:grayscale(1)!important;}\n/* [Y2K·修复 自动合计金额被标签浮层遮挡] 默认卡片价格位于 .thumb-overlay 底部，\n   被 v2 的 .card-tags 绝对浮层(z-index:5, 图片底部粉色带)盖住。把价格行抬到浮层之上并显示。 */\nbody:not(.compact-mode) [data-ai-theme] .art-card .thumb-meta{ margin-bottom: 46px !important; }\nbody:not(.compact-mode) [data-ai-theme] .art-card .thumb-price{ position: relative !important; z-index: 6 !important; }",
