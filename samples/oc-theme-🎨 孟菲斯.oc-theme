    "designMode": "free",
    "customCss": "/* Claymorphism 黏土拟态 兼容原有页面变量体系，切换data-theme=\"clay\"立刻生效 */\n:root[data-theme=\"clay\"] {/* 覆盖原有全局配色变量 */\n  --bg: #fff8f0 !important; --surface: #ffffff !important; --surface-hover: #ffe8dd !important; --border: #f0ddcf !important; --text: #443830 !important; --text-secondary: #947e70 !important; --accent: #f2b8a0 !important; --accent-dark: #e8a98f !important; --accent-light: #ffe8dd !important; --danger: #d88878 !important; --success: #8eb98f !important; /* 重写阴影为黏土双层软3D效果 */\n  --shadow-sm: 0 -3px 8px rgba(255,255,255,0.7), 3px 4px 10px rgba(160,120,90,0.16) !important; --shadow: 0 -4px 10px rgba(255,255,255,0.8), 6px 8px 18px rgba(160,120,90,0.22) !important; /* 放大圆角统一黏土圆润风格 */\n  --radius: 22px !important; --radius-sm: 10px !important; --transition: 0.22 cubic-bezier(0.2,0,0.2,1) !important;}\n\n/* 全局统一黏土质感重写原有组件，无需改页面class */\n:root[data-theme=\"clay\"] .art-card {border: 2px solid rgba(255,240,230,0.75) !important;}\n:root[data-theme=\"clay\"] .art-card:hover {transform: translateY(-5px) !important; box-shadow: 0 -4px 10px rgba(255,255,255,0.8), 9px 12px 24px rgba(160,120,90,0.26) !important;}\n:root[data-theme=\"clay\"] .btn {border: 1.8px solid rgba(255,240,230,0.75) !important;}\n:root[data-theme=\"clay\"] .btn:hover {transform: translateY(-2px) !important; box-shadow: var(--shadow-sm) !important;}\n:root[data-theme=\"clay\"] .btn.primary {border: none !important;}\n:root[data-theme=\"clay\"] input,\n:root[data-theme=\"clay\"] select {box-shadow: inset 0 2px 4px rgba(140,110,80,0.08) !important;}\n:root[data-theme=\"clay\"] .modal {border: 2px solid rgba(255,240,230,0.75) !important;}\n:root[data-theme=\"clay\"] .sidebar,\n:root[data-theme=\"clay\"] .topbar {border: 2px solid rgba(255,240,230,0.75) !important;}\n:root[data-theme=\"clay\"] .tag,\n:root[data-theme=\"clay\"] .badge {border-radius: 10px !important;}\n:root[data-theme=\"clay\"] .sel-bar,\n:root[data-trash] .trash-bar {border: 2px solid rgba(255,240,230,0.75) !important;}",
    "customHtml": "<!DOCTYPE html>\n<html lang=\"zh-CN\" data-theme=\"clay\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>黏土主题测试页</title>\n<style>\n/* 黏土主题变量 */\n:root[data-theme=\"clay\"] {\n  --bg: #fff8f0;\n  --surface: #ffffff;\n  --surface-hover: #ffe8dd;\n  --border: #f0ddcf;\n  --text: #443830;\n  --text-secondary: #947e70;\n  --accent: #f2b8a0;\n  --accent-dark: #e8a98f;\n  --accent-light: #ffe8dd;\n  --shadow-sm: 0 -3px 8px rgba(255,255,255,0.7), 3px 4px 10px rgba(160,120,90,0.16);\n  --shadow: 0 -4px 10px rgba(255,255,255,0.8), 6px 8px 18px rgba(160,120,90,0.22);\n  --radius: 22px;\n  --radius-sm: 10px;\n  --transition: 0.22 cubic-bezier(0.2,0,0.2,1);\n}\n*{margin:0;padding:0;box-sizing:border;font-family:PingFang SC}\nbody{background:var(--bg);padding:20px;color:var(--text)}\n.topbar{background:var(--surface);border:2px solid rgba(255,240,230,0.75);border-radius:var(--radius);padding:12px 16px;display:flex;gap:10px;align-items:center;margin-bottom:20px;box-shadow:var(--shadow-sm)}\n.art-card{background:var(--surface);border:2px solid rgba(255,240,230,0.75);border-radius:var(--radius);box-shadow:var(--shadow);overflow:hidden;transition:var(--transition);width:220px;cursor:pointer}\n.art-card:hover{transform:translateY(-5px);box-shadow:0 -4px 10px rgba(255,255,255,0.8), 9px 12px 24px rgba(160,120,90,0.26)}\n.thumb{width:100%;aspect-ratio:4/3;object-fit:cover;display:block}\n.info{padding:14px}\n.title{font-weight:600;margin-bottom:6px}\n.meta{font-size:0.82px;color:var(--text-secondary)}\n.btn{padding:8px 16px;border-radius:var(--radius-sm);border:1.8px solid rgba(255,240,230,0.75);background:var(--surface);cursor:pointer;transition:var(--transition)}\n.btn:hover{transform:translateY(-2px);box-shadow:var(--shadow-sm)}\n.btn.primary{background:var(--accent);color:#fff;border:none}\n.grid{display:grid;grid-template-columns:repeat(auto-fill,220px);gap:18px}\n</style>\n</head>\n<body>\n<div class=\"topbar\">\n  <span>黏土主题测试</span>\n  <button class=\"btn primary\">新增稿件</button>\n  <button class=\"btn\">筛选</button>\n</div>\n<div class=\"grid\">\n  <div class=\"art-card\">\n    <img class=\"thumb\" src=\"https://picsum.photos/id/237/400/300\">\n    <div class=\"info\">\n      <div class=\"title\">OC立绘</div>\n      <div class=\"meta\">¥120 | 已付款</div>\n    </div>\n  </div>\n</div>\n</body>\n</html>",
    "spacing": {
      "base": 8,
      "scale": 1
    },
